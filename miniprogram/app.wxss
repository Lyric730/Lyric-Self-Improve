@import "./styles/tokens.wxss";

page {
  min-height: 100%;
  color: var(--yh-color-text);
  background:
    linear-gradient(145deg, var(--yh-color-bg), var(--yh-color-bg-2) 46%, #070604),
    repeating-linear-gradient(135deg, rgba(255, 118, 0, 0.035) 0 2rpx, transparent 2rpx 44rpx);
  font-family: var(--yh-font-cn);
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: 1;
}
