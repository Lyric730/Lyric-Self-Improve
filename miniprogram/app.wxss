@import "./styles/tokens.wxss";

page {
  min-height: 100%;
  color: var(--yh-color-text);
  background:
    radial-gradient(circle at 18% 0%, rgba(116, 64, 30, 0.32), transparent 360%),
    radial-gradient(circle at 92% 4%, rgba(255, 122, 0, 0.18), transparent 300rpx),
    linear-gradient(145deg, var(--yh-color-bg), var(--yh-color-bg-2) 46%, #120905),
    repeating-linear-gradient(135deg, rgba(255, 214, 145, 0.035) 0 2rpx, transparent 2rpx 44rpx);
  font-family: var(--yh-font-cn);
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: 1;
}
