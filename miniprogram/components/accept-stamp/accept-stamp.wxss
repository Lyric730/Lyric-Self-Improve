@import "../../styles/tokens.wxss";

.accept-stamp {
  display: grid;
  justify-items: center;
  gap: 8rpx;
  min-height: 200rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(239, 77, 50, 0.28);
  background:
    radial-gradient(circle at 50% 38%, rgba(239, 77, 50, 0.12), transparent 190rpx),
    linear-gradient(180deg, rgba(36, 18, 13, 0.82), rgba(14, 9, 7, 0.9));
  clip-path: polygon(18rpx 0, calc(100% - 18rpx) 0, 100% 18rpx, 100% calc(100% - 18rpx), calc(100% - 18rpx) 100%, 18rpx 100%, 0 calc(100% - 18rpx), 0 18rpx);
}

.accept-stamp__asset {
  width: 168rpx;
  height: 140rpx;
}

.accept-stamp__label {
  color: var(--yh-color-text-muted);
  font-size: 20rpx;
  font-weight: 800;
}
