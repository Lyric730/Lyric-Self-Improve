@import "../../styles/tokens.wxss";

.accept-stamp {
  display: grid;
  justify-items: center;
  gap: 8rpx;
  min-height: 200rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(239, 77, 50, 0.28);
  background: rgba(13, 8, 7, 0.86);
}

.accept-stamp__asset {
  width: 168rpx;
  height: 140rpx;
}

.accept-stamp__label {
  color: var(--yh-color-text-muted);
  font-size: 20rpx;
  font-weight: 800;
}
