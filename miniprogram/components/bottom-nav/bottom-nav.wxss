@import "../../styles/tokens.wxss";

.bottom-nav {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: 22rpx;
  z-index: 20;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  min-height: 102rpx;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(43, 31, 20, 0.96), rgba(16, 12, 9, 0.96)),
    repeating-linear-gradient(135deg, rgba(255, 239, 214, 0.03) 0 2rpx, transparent 2rpx 22rpx);
  border: 1rpx solid rgba(255, 220, 164, 0.2);
  box-shadow:
    0 18rpx 42rpx rgba(0, 0, 0, 0.28),
    inset 0 1rpx 0 rgba(255, 220, 164, 0.16),
    inset 0 -8rpx 0 rgba(0, 0, 0, 0.18);
  clip-path: polygon(
    22rpx 0,
    calc(100% - 22rpx) 0,
    100% 22rpx,
    100% calc(100% - 22rpx),
    calc(100% - 22rpx) 100%,
    22rpx 100%,
    0 calc(100% - 22rpx),
    0 22rpx
  );
}

.bottom-nav__item {
  position: relative;
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 6rpx;
  min-width: 0;
  color: var(--yh-color-text-muted);
  font-size: 21rpx;
  font-weight: 900;
  box-sizing: border-box;
  transition: color var(--yh-motion-fast) var(--yh-ease-out),
    background var(--yh-motion-fast) var(--yh-ease-out),
    transform var(--yh-motion-fast) var(--yh-ease-out);
}

.bottom-nav__item:active {
  transform: translateY(2rpx);
}

.bottom-nav__item::after {
  content: "";
  position: absolute;
  right: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 1rpx;
  background: rgba(255, 214, 145, 0.1);
}

.bottom-nav__item:last-child::after {
  display: none;
}

.bottom-nav__item.is-active {
  color: #1a0d04;
  background:
    linear-gradient(180deg, rgba(255, 192, 92, 0.94), rgba(255, 122, 0, 0.86)),
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0 2rpx, transparent 2rpx 18rpx);
  box-shadow: inset 0 -6rpx 0 rgba(104, 33, 0, 0.24);
}

.bottom-nav__icon,
.bottom-nav__label {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-nav__icon {
  width: 38rpx;
  height: 34rpx;
  color: inherit;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.bottom-nav__label {
  font-size: 21rpx;
  line-height: 1;
}
