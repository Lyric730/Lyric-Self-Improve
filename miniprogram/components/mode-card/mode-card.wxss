@import "../../styles/tokens.wxss";

.mode-card {
  position: relative;
  min-height: 236rpx;
  padding: 26rpx 22rpx 22rpx;
  overflow: hidden;
  color: var(--yh-color-text);
  box-sizing: border-box;
  background:
    linear-gradient(155deg, rgba(60, 45, 30, 0.98) 0%, rgba(25, 22, 17, 0.98) 64%, rgba(12, 12, 10, 0.98) 100%),
    repeating-linear-gradient(135deg, rgba(255, 239, 214, 0.04) 0 2rpx, transparent 2rpx 22rpx);
  clip-path: polygon(
    22rpx 0,
    calc(100% - 24rpx) 0,
    100% 24rpx,
    100% calc(100% - 18rpx),
    calc(100% - 18rpx) 100%,
    0 100%,
    0 22rpx
  );
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 214, 145, 0.18),
    inset 0 -10rpx 0 rgba(0, 0, 0, 0.22),
    0 18rpx 28rpx rgba(0, 0, 0, 0.28);
  transition: transform var(--yh-motion-fast) var(--yh-ease-out),
    opacity var(--yh-motion-fast) var(--yh-ease-out);
}

.mode-card:active {
  transform: translateY(2rpx) scale(0.985);
}

.mode-card__grain,
.mode-card__corner {
  position: absolute;
  pointer-events: none;
}

.mode-card__grain {
  inset: 0;
  opacity: 0.82;
  background:
    linear-gradient(145deg, transparent 0 30%, rgba(255, 118, 0, 0.08) 30% 34%, transparent 34% 100%),
    repeating-linear-gradient(90deg, transparent 0 26rpx, rgba(255, 255, 255, 0.03) 26rpx 28rpx);
}

.mode-card__corner {
  width: 58rpx;
  height: 58rpx;
}

.mode-card__corner--top {
  top: 10rpx;
  right: 10rpx;
  border-top: 1rpx solid rgba(255, 118, 0, 0.55);
  border-right: 1rpx solid rgba(255, 118, 0, 0.55);
}

.mode-card__corner--bottom {
  left: 10rpx;
  bottom: 10rpx;
  border-bottom: 1rpx solid rgba(217, 164, 65, 0.36);
  border-left: 1rpx solid rgba(217, 164, 65, 0.36);
}

.mode-card__body {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 10rpx;
  min-height: 148rpx;
  align-content: center;
}

.mode-card__title-row {
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
  line-height: 0.85;
}

.mode-card__prefix,
.mode-card__number {
  color: #d6c7b0;
  font-weight: 900;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.5);
}

.mode-card__prefix {
  font-size: 54rpx;
}

.mode-card__number {
  font-family: var(--yh-font-number);
  font-size: 76rpx;
}

.mode-card__desc {
  display: block;
  color: #bda98e;
  font-size: 22rpx;
  font-weight: 700;
}

.mode-card__rule {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 10rpx;
  color: #8f7d69;
  font-size: 20rpx;
  font-weight: 700;
}

.mode-card__tag {
  position: absolute;
  z-index: 1;
  left: 0;
  right: 0;
  bottom: 14rpx;
  color: #9b8062;
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
}

.mode-card__lock {
  position: absolute;
  z-index: 2;
  top: 22rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: #514d47;
  font-size: 20rpx;
  font-weight: 900;
  border: 2rpx solid rgba(140, 137, 132, 0.34);
  border-radius: 6rpx;
}

.mode-card.is-selected {
  background:
    linear-gradient(155deg, rgba(88, 49, 19, 1) 0%, rgba(31, 22, 13, 0.99) 58%, rgba(15, 10, 7, 0.98) 100%),
    repeating-linear-gradient(135deg, rgba(255, 122, 0, 0.08) 0 2rpx, transparent 2rpx 22rpx);
  box-shadow:
    inset 0 0 0 3rpx rgba(255, 118, 0, 0.88),
    inset 0 0 0 6rpx rgba(255, 211, 107, 0.12),
    inset 0 -10rpx 0 rgba(93, 28, 0, 0.3),
    0 0 34rpx rgba(255, 118, 0, 0.28);
}

.mode-card.is-selected .mode-card__prefix,
.mode-card.is-selected .mode-card__number {
  color: var(--yh-color-orange);
  text-shadow:
    0 0 18rpx rgba(255, 118, 0, 0.42),
    0 2rpx 0 rgba(0, 0, 0, 0.55);
}

.mode-card.is-selected .mode-card__desc {
  color: #ffbf6d;
}

.mode-card.is-selected .mode-card__rule,
.mode-card.is-selected .mode-card__tag {
  color: #ef7a12;
}

.mode-card.is-disabled {
  opacity: 0.58;
  background:
    linear-gradient(155deg, rgba(41, 40, 37, 0.96), rgba(18, 18, 17, 0.98) 62%, rgba(9, 9, 8, 0.98)),
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.025) 0 2rpx, transparent 2rpx 22rpx);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.08),
    inset 0 -10rpx 0 rgba(0, 0, 0, 0.22);
}

.mode-card.is-disabled .mode-card__prefix,
.mode-card.is-disabled .mode-card__number,
.mode-card.is-disabled .mode-card__desc,
.mode-card.is-disabled .mode-card__rule,
.mode-card.is-disabled .mode-card__tag {
  color: #5e5850;
}
