@import "../../styles/tokens.wxss";

.rank-badge {
  position: relative;
  display: grid;
  grid-template-columns: 130rpx minmax(0, 1fr);
  align-items: center;
  gap: 20rpx;
  min-height: 176rpx;
  padding: 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 118, 0, 0.34);
  background:
    linear-gradient(135deg, rgba(255, 118, 0, 0.12), transparent 42%),
    rgba(18, 14, 10, 0.88);
  clip-path: polygon(0 18rpx, 18rpx 0, 100% 0, 100% calc(100% - 18rpx), calc(100% - 18rpx) 100%, 0 100%);
}

.rank-badge--featured {
  grid-template-columns: 168rpx minmax(0, 1fr);
}

.rank-badge__asset {
  width: 130rpx;
  height: 130rpx;
  filter: drop-shadow(0 0 20rpx rgba(255, 192, 84, 0.24));
}

.rank-badge--featured .rank-badge__asset {
  width: 168rpx;
  height: 168rpx;
}

.rank-badge__body {
  min-width: 0;
}

.rank-badge__title,
.rank-badge__points,
.rank-badge__hint {
  display: block;
}

.rank-badge__title {
  color: var(--yh-color-gold-bright);
  font-size: 30rpx;
  font-weight: 900;
}

.rank-badge__points {
  margin-top: 8rpx;
  color: var(--yh-color-orange);
  font-family: var(--yh-font-number);
  font-size: 24rpx;
  font-weight: 900;
}

.rank-badge__bar {
  width: 100%;
  height: 10rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.08);
}

.rank-badge__bar > text {
  display: block;
  width: 72%;
  height: 100%;
  background: linear-gradient(90deg, var(--yh-color-orange), var(--yh-color-gold-bright));
}

.rank-badge__hint {
  margin-top: 10rpx;
  color: var(--yh-color-text-muted);
  font-size: 20rpx;
  font-weight: 700;
}
