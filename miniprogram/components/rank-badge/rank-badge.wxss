@import "../../styles/tokens.wxss";
@import "../../styles/motion.wxss";

.rank-badge {
  position: relative;
  display: grid;
  grid-template-columns: 130rpx minmax(0, 1fr);
  align-items: center;
  gap: 20rpx;
  min-height: 176rpx;
  padding: 22rpx 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 211, 107, 0.38);
  background:
    radial-gradient(circle at 22% 44%, rgba(255, 219, 122, 0.14), transparent 180rpx),
    linear-gradient(135deg, rgba(52, 35, 20, 0.92), rgba(15, 11, 8, 0.94)),
    repeating-linear-gradient(90deg, rgba(255, 122, 0, 0.035) 0 2rpx, transparent 2rpx 28rpx);
  clip-path: polygon(0 18rpx, 18rpx 0, 100% 0, 100% calc(100% - 18rpx), calc(100% - 18rpx) 100%, 0 100%);
  animation: yh-flow-enter var(--yh-motion-slow) var(--yh-ease-out) both;
}

.rank-badge--featured {
  grid-template-columns: 168rpx minmax(0, 1fr);
}

.rank-badge__asset {
  width: 130rpx;
  height: 130rpx;
  filter: drop-shadow(0 0 22rpx rgba(255, 192, 84, 0.28));
}

.rank-badge--featured .rank-badge__asset {
  width: 168rpx;
  height: 168rpx;
}

.rank-badge__body {
  min-width: 0;
}

.rank-badge__title,
.rank-badge__points,
.rank-badge__hint {
  display: block;
}

.rank-badge__title {
  color: var(--yh-color-gold-bright);
  font-size: 30rpx;
  font-weight: 900;
}

.rank-badge__points {
  margin-top: 8rpx;
  color: var(--yh-color-orange);
  font-family: var(--yh-font-number);
  font-size: 24rpx;
  font-weight: 900;
}

.rank-badge__bar {
  width: 100%;
  height: 10rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 99rpx;
  background: rgba(255, 239, 214, 0.12);
  border: 1rpx solid rgba(255, 220, 164, 0.1);
}

.rank-badge__bar > text {
  display: block;
  width: 72%;
  height: 100%;
  background: linear-gradient(90deg, var(--yh-color-orange), var(--yh-color-gold-bright));
}

.rank-badge__hint {
  margin-top: 10rpx;
  color: var(--yh-color-text-muted);
  font-size: 20rpx;
  font-weight: 700;
}
