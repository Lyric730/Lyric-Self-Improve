@import "../../styles/tokens.wxss";

.reward-crate {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 30rpx;
  overflow: hidden;
  color: var(--yh-color-text);
  background:
    radial-gradient(circle at 76% 32%, rgba(255, 118, 0, 0.24), transparent 210rpx),
    radial-gradient(circle at 26% 18%, rgba(217, 164, 65, 0.14), transparent 170rpx),
    linear-gradient(150deg, rgba(35, 25, 14, 0.98), rgba(12, 10, 8, 1) 58%, rgba(6, 6, 5, 1)),
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.028) 0 2rpx, transparent 2rpx 28rpx);
  clip-path: polygon(
    24rpx 0,
    calc(100% - 24rpx) 0,
    100% 24rpx,
    100% calc(100% - 24rpx),
    calc(100% - 24rpx) 100%,
    24rpx 100%,
    0 calc(100% - 24rpx),
    0 24rpx
  );
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 118, 0, 0.42),
    inset 0 0 0 3rpx rgba(255, 211, 107, 0.05),
    0 20rpx 44rpx rgba(0, 0, 0, 0.36);
}

.reward-crate__grain,
.reward-crate__rail {
  position: absolute;
  pointer-events: none;
}

.reward-crate__grain {
  inset: 0;
  opacity: 0.92;
  background:
    linear-gradient(122deg, transparent 0 40%, rgba(255, 118, 0, 0.08) 40% 42%, transparent 42% 100%),
    linear-gradient(26deg, transparent 0 72%, rgba(217, 164, 65, 0.08) 72% 73%, transparent 73% 100%);
}

.reward-crate__rail {
  left: 28rpx;
  right: 28rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 176, 65, 0.72), transparent);
}

.reward-crate__rail--top {
  top: 12rpx;
}

.reward-crate__rail--bottom {
  bottom: 12rpx;
}

.reward-crate__head,
.reward-crate__body,
.reward-cycle,
.reward-crate__footer {
  position: relative;
  z-index: 1;
}

.reward-crate__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.reward-crate__kicker {
  color: #ff7a00;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.reward-crate__title {
  display: block;
  margin-top: 8rpx;
  color: #ffe0a4;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.08;
  text-shadow: 0 0 18rpx rgba(255, 118, 0, 0.22);
}

.reward-crate__copy {
  display: block;
  margin-top: 10rpx;
  color: #9e896f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.reward-crate__badge {
  flex: 0 0 auto;
  padding: 10rpx 14rpx;
  color: #2b1200;
  font-size: 20rpx;
  font-weight: 900;
  background: linear-gradient(180deg, #ffd36b, #d99a28);
  clip-path: polygon(12rpx 0, 100% 0, 100% calc(100% - 12rpx), calc(100% - 12rpx) 100%, 0 100%, 0 12rpx);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 240, 190, 0.72),
    0 0 20rpx rgba(217, 164, 65, 0.24);
}

.reward-crate__body {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.crate-visual {
  position: relative;
  display: flex;
  flex: 0 0 220rpx;
  align-items: center;
  justify-content: center;
  height: 190rpx;
}

.crate-visual__halo {
  position: absolute;
  width: 174rpx;
  height: 112rpx;
  background: radial-gradient(circle, rgba(255, 118, 0, 0.42), transparent 70%);
  border-radius: 999rpx;
  transform: translateY(18rpx);
}

.crate-visual__lid,
.crate-visual__body,
.crate-visual__feet {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
}

.crate-visual__lid {
  top: 32rpx;
  height: 58rpx;
  background:
    linear-gradient(180deg, #4a3f31, #17110b 64%, #080706),
    repeating-linear-gradient(90deg, rgba(255, 211, 107, 0.2) 0 2rpx, transparent 2rpx 34rpx);
  clip-path: polygon(22rpx 0, calc(100% - 22rpx) 0, 100% 22rpx, calc(100% - 12rpx) 100%, 12rpx 100%, 0 22rpx);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 211, 107, 0.46),
    0 8rpx 18rpx rgba(0, 0, 0, 0.34);
}

.crate-visual__lock {
  position: absolute;
  left: 50%;
  top: 22rpx;
  width: 44rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #ffd36b, #a95c09);
  clip-path: polygon(10rpx 0, calc(100% - 10rpx) 0, 100% 10rpx, 100% 100%, 0 100%, 0 10rpx);
  transform: translateX(-50%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 242, 192, 0.7);
}

.crate-visual__body {
  top: 78rpx;
  height: 86rpx;
  background:
    linear-gradient(145deg, #35281d, #0c0a08 62%, #060504),
    repeating-linear-gradient(135deg, rgba(255, 118, 0, 0.16) 0 3rpx, transparent 3rpx 32rpx);
  clip-path: polygon(10rpx 0, calc(100% - 10rpx) 0, 100% 14rpx, calc(100% - 18rpx) 100%, 18rpx 100%, 0 14rpx);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 118, 0, 0.5),
    inset 0 -16rpx 0 rgba(0, 0, 0, 0.28);
}

.crate-visual__slot {
  position: absolute;
  top: 16rpx;
  width: 36rpx;
  height: 50rpx;
  background: linear-gradient(180deg, rgba(255, 180, 72, 0.72), rgba(102, 39, 0, 0.36));
  clip-path: polygon(8rpx 0, 100% 0, calc(100% - 8rpx) 100%, 0 100%);
}

.crate-visual__slot--left {
  left: 24rpx;
}

.crate-visual__slot--right {
  right: 24rpx;
  transform: scaleX(-1);
}

.crate-visual__mark {
  position: absolute;
  left: 50%;
  top: 18rpx;
  color: #ffe6a8;
  font-family: var(--yh-font-number);
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 0 18rpx rgba(255, 118, 0, 0.62);
  transform: translateX(-50%);
}

.crate-visual__feet {
  bottom: 8rpx;
  height: 14rpx;
  background: linear-gradient(90deg, transparent, rgba(217, 164, 65, 0.36), transparent);
}

.reward-math {
  display: flex;
  flex: 1 1 280rpx;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.reward-math__row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx;
  background: linear-gradient(145deg, rgba(20, 16, 11, 0.92), rgba(7, 7, 6, 0.96));
  clip-path: polygon(16rpx 0, calc(100% - 16rpx) 0, 100% 16rpx, 100% calc(100% - 16rpx), calc(100% - 16rpx) 100%, 16rpx 100%, 0 calc(100% - 16rpx), 0 16rpx);
  box-shadow: inset 0 0 0 1rpx rgba(217, 164, 65, 0.22);
}

.reward-math__row--sprint {
  background:
    radial-gradient(circle at 90% 10%, rgba(255, 118, 0, 0.2), transparent 110rpx),
    linear-gradient(145deg, rgba(58, 30, 7, 0.95), rgba(13, 10, 7, 0.98));
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 118, 0, 0.52),
    0 0 26rpx rgba(255, 118, 0, 0.18);
}

.reward-math__label {
  color: #d7a149;
  font-size: 20rpx;
  font-weight: 900;
}

.reward-math__value-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.reward-math__value {
  color: #ffe0a4;
  font-family: var(--yh-font-number);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.reward-math__unit {
  color: #d1b890;
  font-size: 24rpx;
  font-weight: 900;
}

.reward-cycle {
  display: flex;
  gap: 12rpx;
}

.reward-stage {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  padding: 14rpx 6rpx 12rpx;
  background: rgba(255, 255, 255, 0.035);
  clip-path: polygon(10rpx 0, calc(100% - 10rpx) 0, 100% 10rpx, 100% calc(100% - 10rpx), calc(100% - 10rpx) 100%, 10rpx 100%, 0 calc(100% - 10rpx), 0 10rpx);
  box-shadow: inset 0 0 0 1rpx rgba(255, 211, 107, 0.1);
}

.reward-stage.is-active {
  background: rgba(217, 164, 65, 0.12);
  box-shadow: inset 0 0 0 1rpx rgba(217, 164, 65, 0.38);
}

.reward-stage.is-current {
  background: rgba(255, 118, 0, 0.16);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 118, 0, 0.62),
    0 0 18rpx rgba(255, 118, 0, 0.18);
}

.reward-stage.is-sprint.is-current {
  background: linear-gradient(180deg, rgba(255, 118, 0, 0.3), rgba(90, 38, 4, 0.26));
}

.reward-stage__dot {
  width: 14rpx;
  height: 14rpx;
  background: #4a3b2d;
  border-radius: 999rpx;
}

.reward-stage.is-active .reward-stage__dot {
  background: #d9a441;
  box-shadow: 0 0 12rpx rgba(217, 164, 65, 0.42);
}

.reward-stage.is-current .reward-stage__dot {
  background: #ff7a00;
  box-shadow: 0 0 16rpx rgba(255, 118, 0, 0.72);
}

.reward-stage__label {
  color: #8f7a63;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.reward-stage.is-active .reward-stage__label {
  color: #e5c58f;
}

.reward-stage.is-current .reward-stage__label {
  color: #ffe0a4;
}

.reward-crate__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  background: linear-gradient(145deg, rgba(18, 14, 10, 0.88), rgba(7, 7, 6, 0.94));
  clip-path: polygon(16rpx 0, calc(100% - 16rpx) 0, 100% 16rpx, calc(100% - 16rpx) 100%, 16rpx 100%, 0 16rpx);
  box-shadow: inset 0 0 0 1rpx rgba(255, 118, 0, 0.22);
}

.reward-crate__footer-label {
  color: #ffb14b;
  font-size: 22rpx;
  font-weight: 900;
}

.reward-crate__footer-copy {
  display: block;
  margin-top: 6rpx;
  color: #8c7760;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
}

.reward-crate__boost {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  color: #ff7a00;
  font-family: var(--yh-font-number);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 0 18rpx rgba(255, 118, 0, 0.42);
}
