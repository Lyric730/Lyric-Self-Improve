@import "../../styles/tokens.wxss";
@import "../../styles/motion.wxss";

.settlement-badge {
  display: grid;
  justify-items: center;
  gap: 10rpx;
  min-height: 230rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 220, 164, 0.22);
  background:
    radial-gradient(circle at 50% 22%, rgba(255, 211, 107, 0.1), transparent 160rpx),
    linear-gradient(180deg, rgba(45, 31, 19, 0.78), rgba(13, 10, 8, 0.88));
  clip-path: polygon(0 18rpx, 18rpx 0, 100% 0, 100% calc(100% - 18rpx), calc(100% - 18rpx) 100%, 0 100%);
  animation: yh-flow-enter var(--yh-motion-slow) var(--yh-ease-out) both;
}

.settlement-badge__asset {
  width: 188rpx;
  height: 188rpx;
  filter: drop-shadow(0 12rpx 18rpx rgba(0, 0, 0, 0.34));
}

.settlement-badge__label {
  color: var(--yh-color-text-muted);
  font-size: 20rpx;
  font-weight: 800;
}

.settlement-badge--plus .settlement-badge__label,
.settlement-badge--rankUp .settlement-badge__label,
.settlement-badge--reward .settlement-badge__label {
  color: var(--yh-color-gold-bright);
}

.settlement-badge--minus .settlement-badge__label {
  color: var(--yh-color-danger);
}
