@import "../../styles/tokens.wxss";
@import "../../styles/motion.wxss";

.victory-banner {
  display: grid;
  justify-items: center;
  gap: 8rpx;
  padding: 26rpx 20rpx;
  border: 1rpx solid rgba(255, 211, 107, 0.38);
  background:
    radial-gradient(circle at 50% 42%, rgba(255, 219, 122, 0.2), transparent 210rpx),
    linear-gradient(180deg, rgba(57, 38, 20, 0.86), rgba(13, 9, 6, 0.92));
  clip-path: polygon(24rpx 0, calc(100% - 24rpx) 0, 100% 24rpx, 100% calc(100% - 24rpx), calc(100% - 24rpx) 100%, 24rpx 100%, 0 calc(100% - 24rpx), 0 24rpx);
  animation: yh-flow-enter var(--yh-motion-slow) var(--yh-ease-out) both;
}

.victory-banner__asset {
  width: 300rpx;
  height: 156rpx;
  filter: drop-shadow(0 12rpx 20rpx rgba(0, 0, 0, 0.36));
}

.victory-banner__subtitle {
  color: var(--yh-color-text-muted);
  font-size: 20rpx;
  font-weight: 800;
}
