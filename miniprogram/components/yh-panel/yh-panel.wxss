@import "../../styles/tokens.wxss";
@import "../../styles/motion.wxss";

.yh-panel {
  position: relative;
  padding: var(--yh-space-4);
  overflow: hidden;
  color: var(--yh-color-text);
  background: var(--yh-surface-panel);
  border: 1rpx solid var(--yh-color-line);
  border-radius: var(--yh-radius-md);
  box-shadow: var(--yh-shadow-panel);
  animation: yh-flow-enter var(--yh-motion-slow) var(--yh-ease-out) both;
}

.yh-panel::before {
  content: "";
  position: absolute;
  right: -42rpx;
  bottom: -42rpx;
  width: 128rpx;
  height: 128rpx;
  border: 1rpx solid rgba(255, 122, 0, 0.24);
  border-radius: 999rpx;
  pointer-events: none;
}

.yh-panel::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 8rpx;
  height: 2rpx;
  opacity: 0.76;
  background: linear-gradient(90deg, transparent, rgba(255, 219, 122, 0.5), rgba(255, 122, 0, 0.32), transparent);
  pointer-events: none;
}

.yh-panel--cut {
  clip-path: polygon(
    0 0,
    calc(100% - var(--yh-cut-md)) 0,
    100% var(--yh-cut-md),
    100% 100%,
    var(--yh-cut-md) 100%,
    0 calc(100% - var(--yh-cut-md))
  );
}

.yh-panel--raised {
  background:
    linear-gradient(145deg, var(--yh-color-panel-raised), var(--yh-color-panel)),
    repeating-linear-gradient(90deg, rgba(255, 122, 0, 0.04) 0 2rpx, transparent 2rpx 28rpx);
}

.yh-panel--orange {
  border-color: var(--yh-color-line-strong);
  background:
    linear-gradient(145deg, rgba(75, 42, 18, 0.98), rgba(28, 20, 13, 0.98)),
    repeating-linear-gradient(135deg, rgba(255, 122, 0, 0.055) 0 2rpx, transparent 2rpx 28rpx);
  box-shadow: var(--yh-shadow-panel), 0 0 22rpx rgba(255, 122, 0, 0.22);
}

.yh-panel--gold {
  border-color: rgba(255, 211, 107, 0.5);
  background:
    radial-gradient(circle at 82% 0%, rgba(255, 219, 122, 0.12), transparent 210rpx),
    linear-gradient(145deg, rgba(66, 47, 25, 0.98), rgba(24, 18, 12, 0.98));
  box-shadow: var(--yh-shadow-panel), 0 0 26rpx rgba(217, 164, 65, 0.18);
}

.yh-panel--success {
  border-color: rgba(246, 185, 74, 0.46);
  background:
    radial-gradient(circle at 84% 0%, rgba(255, 219, 122, 0.12), transparent 190rpx),
    linear-gradient(145deg, rgba(58, 42, 23, 0.95), rgba(18, 14, 10, 0.98));
}

.yh-panel--danger {
  border-color: rgba(239, 77, 50, 0.48);
}

.yh-panel__header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--yh-space-3);
  margin-bottom: var(--yh-space-3);
}

.yh-panel__marker {
  display: block;
  margin-bottom: var(--yh-space-1);
  color: var(--yh-color-orange);
  font-size: var(--yh-text-xs);
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.yh-panel__title {
  display: block;
  color: var(--yh-color-text);
  font-size: var(--yh-text-lg);
  font-weight: 900;
  line-height: 1.18;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.24);
}

.yh-panel__subtitle {
  display: block;
  margin-top: var(--yh-space-1);
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  line-height: 1.45;
}

.yh-panel__body {
  position: relative;
  z-index: 1;
}
