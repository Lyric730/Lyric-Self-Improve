@import "../../styles/tokens.wxss";

.yh-panel {
  position: relative;
  padding: var(--yh-space-4);
  overflow: hidden;
  color: var(--yh-color-text);
  background:
    linear-gradient(145deg, rgba(45, 33, 22, 0.96), rgba(18, 14, 10, 0.98)),
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0 2rpx, transparent 2rpx 28rpx);
  border: 1rpx solid var(--yh-color-line);
  border-radius: var(--yh-radius-md);
  box-shadow: var(--yh-shadow-panel);
}

.yh-panel::before {
  content: "";
  position: absolute;
  right: -58rpx;
  bottom: -58rpx;
  width: 132rpx;
  height: 132rpx;
  border: 1rpx solid rgba(255, 118, 0, 0.22);
  border-radius: 999rpx;
  pointer-events: none;
}

.yh-panel--cut {
  clip-path: polygon(
    0 0,
    calc(100% - var(--yh-cut-md)) 0,
    100% var(--yh-cut-md),
    100% 100%,
    var(--yh-cut-md) 100%,
    0 calc(100% - var(--yh-cut-md))
  );
}

.yh-panel--raised {
  background:
    linear-gradient(145deg, var(--yh-color-panel-raised), var(--yh-color-panel)),
    repeating-linear-gradient(90deg, rgba(255, 118, 0, 0.035) 0 2rpx, transparent 2rpx 28rpx);
}

.yh-panel--orange {
  border-color: var(--yh-color-line-strong);
  box-shadow: var(--yh-shadow-panel), var(--yh-glow-orange);
}

.yh-panel--gold {
  border-color: rgba(255, 211, 107, 0.5);
  box-shadow: var(--yh-shadow-panel), var(--yh-shadow-reward);
}

.yh-panel--success {
  border-color: rgba(69, 201, 120, 0.44);
}

.yh-panel--danger {
  border-color: rgba(239, 77, 50, 0.48);
}

.yh-panel__header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--yh-space-3);
  margin-bottom: var(--yh-space-3);
}

.yh-panel__marker {
  display: block;
  margin-bottom: var(--yh-space-1);
  color: var(--yh-color-orange);
  font-size: var(--yh-text-xs);
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.yh-panel__title {
  display: block;
  color: var(--yh-color-text);
  font-size: var(--yh-text-lg);
  font-weight: 900;
  line-height: 1.18;
}

.yh-panel__subtitle {
  display: block;
  margin-top: var(--yh-space-1);
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  line-height: 1.45;
}

.yh-panel__body {
  position: relative;
  z-index: 1;
}
