<view wx:if="{{accessReady}}" class="flow-page flow-page--locked boss-page">
  <view class="flow-hero flow-hero--compact">
    <text class="flow-hero__eyebrow">OWNER CONFIG</text>
    <text class="flow-hero__title">门店参数</text>
    <text class="flow-hero__subtitle">玩法 · 积分 · 防刷分 · 大屏</text>
  </view>

  <view class="flow-stack">
    <yh-panel title="玩法模板" subtitle="顾客只看到已启用玩法" marker="MODES" tone="gold" raised>
      <view class="boss-mode" wx:for="{{adminConfig.modes}}" wx:key="modeId">
        <view class="boss-mode__head">
          <view>
            <text>{{item.name}}</text>
            <text>先胜 {{item.targetWins}} 局 · 最低 {{item.minimumMinutes}} 分钟</text>
          </view>
          <switch checked="{{item.enabled}}" color="#ff7600" data-index="{{index}}" bindchange="toggleMode" />
        </view>

        <view class="config-grid">
          <label class="config-field">
            <text>底分</text>
            <input value="{{item.baseText}}" data-index="{{index}}" data-field="baseText" bindinput="changeModeField" />
          </label>
          <label class="config-field">
            <text>倍率</text>
            <input value="{{item.multiplierText}}" data-index="{{index}}" data-field="multiplierText" bindinput="changeModeField" />
          </label>
          <label class="config-field">
            <text>普通奖励</text>
            <input value="{{item.normalReward}}" data-index="{{index}}" data-field="normalReward" bindinput="changeModeField" />
          </label>
          <label class="config-field">
            <text>冲刺奖励</text>
            <input value="{{item.sprintReward}}" data-index="{{index}}" data-field="sprintReward" bindinput="changeModeField" />
          </label>
          <label class="config-field">
            <text>最低时间</text>
            <input type="number" value="{{item.minimumMinutes}}" data-index="{{index}}" data-field="minimumMinutes" bindinput="changeModeField" />
          </label>
          <label class="config-field">
            <text>胜方加星</text>
            <input type="number" value="{{item.starReward}}" data-index="{{index}}" data-field="starReward" bindinput="changeModeField" />
          </label>
        </view>
      </view>
    </yh-panel>

    <yh-panel title="积分补给" subtitle="用于开局门槛和前台兑换" marker="POINTS">
      <view class="config-grid">
        <label class="config-field">
          <text>新用户</text>
          <input type="number" value="{{adminConfig.points.newUser}}" data-key="newUser" bindinput="changePointsField" />
        </label>
        <label class="config-field">
          <text>到店登录</text>
          <input type="number" value="{{adminConfig.points.checkIn}}" data-key="checkIn" bindinput="changePointsField" />
        </label>
        <label class="config-field">
          <text>开台赠分</text>
          <input type="number" value="{{adminConfig.points.tableOpenBonus}}" data-key="tableOpenBonus" bindinput="changePointsField" />
        </label>
        <label class="config-field config-field--wide">
          <text>兑换门槛</text>
          <input type="number" value="{{adminConfig.points.exchangeThreshold}}" data-key="exchangeThreshold" bindinput="changePointsField" />
        </label>
      </view>
    </yh-panel>

    <yh-panel title="防刷分" subtitle="有效挑战必须满足这些门槛" marker="CHECK" tone="danger">
      <view class="config-grid">
        <label class="config-field">
          <text>店内定位</text>
          <input value="{{adminConfig.antiCheat.geoFence}}" data-key="geoFence" bindinput="changeAntiCheatField" />
        </label>
        <label class="config-field">
          <text>门店纬度</text>
          <input value="{{adminConfig.antiCheat.storeLatitude}}" data-key="storeLatitude" bindinput="changeAntiCheatField" />
        </label>
        <label class="config-field">
          <text>门店经度</text>
          <input value="{{adminConfig.antiCheat.storeLongitude}}" data-key="storeLongitude" bindinput="changeAntiCheatField" />
        </label>
        <label class="config-field">
          <text>开台到点</text>
          <input value="{{adminConfig.antiCheat.tableDueRequired}}" data-key="tableDueRequired" bindinput="changeAntiCheatField" />
        </label>
        <label class="config-field">
          <text>最低时间</text>
          <input value="{{adminConfig.antiCheat.minimumTimeRequired}}" data-key="minimumTimeRequired" bindinput="changeAntiCheatField" />
        </label>
      </view>
    </yh-panel>

    <yh-panel title="大屏榜单" subtitle="{{adminConfig.screen.refreshText}}" marker="SCREEN" tone="orange">
      <view class="config-grid">
        <label class="config-field">
          <text>主榜</text>
          <input value="{{adminConfig.screen.storeBoard}}" data-key="storeBoard" bindinput="changeScreenField" />
        </label>
        <label class="config-field">
          <text>副榜</text>
          <input value="{{adminConfig.screen.bountyBoard}}" data-key="bountyBoard" bindinput="changeScreenField" />
        </label>
        <label class="config-field">
          <text>刷新间隔</text>
          <input value="{{adminConfig.screen.refreshText}}" data-key="refreshText" bindinput="changeScreenField" />
        </label>
      </view>
    </yh-panel>

    <view class="flow-actions">
      <yh-button text="保存配置" size="lg" variant="primary" block loading="{{saving}}" bind:tap="saveConfig" />
    </view>
  </view>
</view>
