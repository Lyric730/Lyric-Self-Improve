@import "../../styles/player-flow.wxss";

.boss-mode {
  display: grid;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 214, 145, 0.1);
}

.boss-mode:last-child {
  border-bottom: 0;
}

.boss-mode__head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 96rpx;
  gap: 18rpx;
  align-items: center;
}

.boss-mode__head view {
  min-width: 0;
}

.boss-mode text {
  display: block;
}

.boss-mode__head view text:first-child {
  color: var(--yh-color-text);
  font-size: var(--yh-text-lg);
  font-weight: 900;
}

.boss-mode__head view text:not(:first-child) {
  margin-top: 8rpx;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 800;
  line-height: 1.35;
}

.config-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.config-field {
  min-width: 0;
  padding: 18rpx;
  background: rgba(8, 7, 6, 0.68);
  border: 1rpx solid rgba(255, 214, 145, 0.14);
  clip-path: polygon(12rpx 0, 100% 0, 100% calc(100% - 12rpx), calc(100% - 12rpx) 100%, 0 100%, 0 12rpx);
}

.config-field--wide {
  grid-column: 1 / -1;
}

.config-field text {
  display: block;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 900;
}

.config-field input {
  width: 100%;
  height: 58rpx;
  margin-top: 8rpx;
  color: var(--yh-color-gold-bright);
  font-family: var(--yh-font-number);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.config-field input::placeholder {
  color: rgba(246, 239, 230, 0.32);
}

.role-admin-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 176rpx;
  gap: 16rpx;
  align-items: stretch;
}

.role-admin-card__member {
  min-width: 0;
  padding: 20rpx;
  background: rgba(8, 7, 6, 0.72);
  border: 1rpx solid rgba(255, 214, 145, 0.14);
  clip-path: polygon(14rpx 0, 100% 0, 100% calc(100% - 14rpx), calc(100% - 14rpx) 100%, 0 100%, 0 14rpx);
}

.role-admin-card__member text {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-admin-card__member text:first-child {
  color: var(--yh-color-text);
  font-size: var(--yh-text-md);
  font-weight: 900;
}

.role-admin-card__member text:last-child {
  margin-top: 8rpx;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 800;
}

.role-admin-scan {
  min-height: 92rpx;
}

.role-picker {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: center;
  margin-top: 18rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(255, 118, 0, 0.16), rgba(8, 7, 6, 0.82));
  border: 1rpx solid rgba(255, 214, 145, 0.2);
  clip-path: polygon(14rpx 0, 100% 0, 100% calc(100% - 14rpx), calc(100% - 14rpx) 100%, 0 100%, 0 14rpx);
}

.role-picker--hover {
  filter: brightness(1.12);
}

.role-picker view {
  min-width: 0;
}

.role-picker text {
  display: block;
}

.role-picker view text:first-child {
  color: var(--yh-color-text);
  font-size: var(--yh-text-md);
  font-weight: 900;
}

.role-picker view text:last-child {
  margin-top: 8rpx;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 800;
  line-height: 1.35;
}

.role-picker > text {
  color: var(--yh-color-gold-bright);
  font-size: 30rpx;
  font-weight: 900;
}
