<view class="flow-page home-page">
  <view class="flow-hero">
    <text class="flow-hero__eyebrow">YUNHAN BILLIARDS CLUB</text>
    <text class="flow-hero__title">{{challengeGate.tableSession.clubName}}</text>
    <text class="flow-hero__subtitle">{{challengeGate.tableSession.tableNo}} 夜赛控制台 · 到点 {{challengeGate.tableSession.dueTime}}</text>
    <view class="flow-table">
      <text>TABLE</text>
      <text>{{challengeGate.tableSession.tableNo}}</text>
    </view>
  </view>

  <view class="flow-stack">
    <view class="home-entry {{canStartChallenge ? 'is-ready' : 'is-locked'}}">
      <view class="home-entry__topline">
        <text>RANKED MATCH</text>
        <text class="{{canStartChallenge ? 'is-live' : 'is-muted'}}">{{playableStatusText}}</text>
      </view>

      <view class="home-entry__main">
        <view class="home-player">
          <view class="avatar-token">{{match.playerA.shortName}}</view>
          <view>
            <text>{{match.playerA.name}}</text>
            <text>{{match.playerA.rankTitle}} · {{match.playerA.points}} 积分</text>
          </view>
        </view>

        <view class="home-table-board">
          <view>
            <text>球桌</text>
            <text>{{challengeGate.tableSession.tableNo}}</text>
          </view>
          <view>
            <text>开台</text>
            <text>{{challengeGate.tableSession.openedAt}}</text>
          </view>
          <view>
            <text>到点</text>
            <text>{{challengeGate.tableSession.dueTime}}</text>
          </view>
        </view>
      </view>

      <view class="home-entry__action">
        <yh-button
          text="发起挑战"
          size="lg"
          variant="primary"
          block
          loading="{{startingChallenge}}"
          disabled="{{!canStartChallenge || startingChallenge}}"
          bind:tap="goWaitingRoom"
        />
        <text wx:if="{{!canStartChallenge}}" class="home-entry__hint">{{gateMessage}}</text>
        <text wx:else class="home-entry__hint">对手加入后，再选择玩法、底分和倍率。</text>
      </view>
    </view>

    <yh-panel title="当前段位" subtitle="全部游戏模式共用一个段位" marker="RANK" tone="gold" raised>
      <rank-badge tier="gold" title="{{match.playerA.rankTitle}}" points="{{match.playerA.points}} / 3000" hint="再得 140 分升至走位黄金 II" featured />
      <view class="flow-actions">
        <star-track value="{{3}}" total="{{5}}" mode="new" />
      </view>
    </yh-panel>

    <view class="home-rule-strip">
      <view>
        <text>当前开放</text>
        <text>抢5 / 抢7</text>
      </view>
      <view>
        <text>开台赠分</text>
        <text>+30</text>
      </view>
      <view>
        <text>有效时间</text>
        <text>最低 40 分钟</text>
      </view>
    </view>

  </view>

  <bottom-nav active="challenge" />
</view>
