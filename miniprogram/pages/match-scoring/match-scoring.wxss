@import "../../styles/player-flow.wxss";

.scoring-state {
  margin: 24rpx;
  padding: 34rpx 30rpx;
  background:
    linear-gradient(135deg, rgba(255, 126, 24, 0.12), transparent 42%),
    rgba(23, 16, 11, 0.96);
  border: 1rpx solid rgba(255, 126, 24, 0.42);
  clip-path: polygon(18rpx 0, 100% 0, 100% calc(100% - 28rpx), calc(100% - 28rpx) 100%, 0 100%, 0 18rpx);
}

.scoring-state--error {
  border-color: rgba(255, 93, 56, 0.58);
}

.scoring-state__title {
  display: block;
  color: #fff8e6;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.scoring-state__text {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 248, 230, 0.7);
  font-size: 24rpx;
  line-height: 1.55;
}

.scoring-state__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}
