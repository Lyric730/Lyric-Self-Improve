@import "../../styles/player-flow.wxss";

.member-code-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 520rpx;
  padding: 22rpx;
  background:
    radial-gradient(circle at center, rgba(255, 118, 0, 0.14), transparent 64%),
    linear-gradient(180deg, rgba(9, 8, 6, 0.74), rgba(22, 15, 9, 0.72));
  border: 1rpx solid rgba(255, 214, 145, 0.16);
  clip-path: polygon(22rpx 0, 100% 0, 100% calc(100% - 22rpx), calc(100% - 22rpx) 100%, 0 100%, 0 22rpx);
}

.member-code-card {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 420rpx;
  padding: 18rpx;
  background: #fff6e5;
  box-shadow:
    0 0 34rpx rgba(255, 118, 0, 0.2),
    inset 0 0 0 4rpx rgba(255, 174, 73, 0.36);
  clip-path: polygon(18rpx 0, 100% 0, 100% calc(100% - 18rpx), calc(100% - 18rpx) 100%, 0 100%, 0 18rpx);
}

.member-code-card image {
  width: 100%;
  height: 100%;
}

.member-code-card--visual {
  display: grid;
  align-content: center;
  gap: 18rpx;
}

.member-code-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  width: 324rpx;
  height: 324rpx;
}

.member-code-grid text {
  display: block;
  background: rgba(245, 181, 76, 0.16);
}

.member-code-grid text.is-dark {
  background: #1b1109;
  box-shadow: inset 0 0 0 1rpx rgba(255, 151, 38, 0.24);
}

.member-code-token {
  display: block;
  color: #1b1109;
  font-family: var(--yh-font-number);
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-align: center;
}

.member-code-state {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 420rpx;
  color: var(--yh-color-gold);
  font-size: var(--yh-text-lg);
  font-weight: 900;
}

.member-code-state--error {
  color: var(--yh-color-text-muted);
  text-align: center;
}

.member-code-points {
  display: block;
  margin-top: 18rpx;
  color: var(--yh-color-gold);
  font-size: var(--yh-text-md);
  font-weight: 900;
  text-align: center;
}
