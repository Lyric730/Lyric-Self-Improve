<view class="flow-page">
  <view class="flow-hero flow-hero--compact">
    <text class="flow-hero__eyebrow">POINTS</text>
    <text class="flow-hero__title">积分礼遇</text>
    <text class="flow-hero__subtitle">当前积分可到前台兑换礼遇</text>
  </view>

  <view wx:if="{{loading}}" class="flow-state">
    <text class="flow-state__title">读取积分礼遇</text>
    <text class="flow-state__text">正在同步当前积分和前台兑换门槛。</text>
  </view>

  <view wx:elif="{{errorText}}" class="flow-state flow-state--error">
    <text class="flow-state__title">积分礼遇读取失败</text>
    <text class="flow-state__text">{{errorText}}</text>
    <yh-button text="重试" variant="primary" size="md" bind:tap="retryLoad" />
  </view>

  <view wx:else class="flow-stack">
    <yh-panel title="当前积分" subtitle="{{pointsPerks.nextRewardText}}" marker="BALANCE" tone="gold" raised>
      <view class="metric-grid">
        <view class="metric-card">
          <text>当前积分</text>
          <text>{{match.playerA.points}}</text>
        </view>
        <view class="metric-card">
          <text>兑换门槛</text>
          <text>{{pointsPerks.exchangeThreshold}}</text>
        </view>
        <view class="metric-card">
          <text>开台赠分</text>
          <text>+{{pointsPerks.tableOpenBonus}}</text>
        </view>
      </view>
    </yh-panel>

    <yh-panel title="前台兑换" subtitle="出示会员码即可核销" marker="COUNTER" tone="default">
      <text class="flow-note">{{pointsPerks.counterHint}}</text>
      <view class="flow-actions">
        <yh-button text="出示会员码" variant="primary" block bind:tap="goMemberCode" />
      </view>
    </yh-panel>
  </view>

  <bottom-nav active="points" />
</view>
