<view class="flow-page flow-page--locked">
  <view class="flow-hero flow-hero--compact">
    <text class="flow-hero__eyebrow">RISK POINTS</text>
    <text class="flow-hero__title">底分 / 倍率</text>
    <text class="flow-hero__subtitle">{{mode.name}} · 先胜 {{mode.targetWins}} 局 · 最低 {{mode.minimumMinutes}} 分钟</text>
  </view>

  <view wx:if="{{loading}}" class="flow-state">
    <text class="flow-state__title">读取挑战参数</text>
    <text class="flow-state__text">正在同步底分、倍率和随机奖励规则</text>
  </view>

  <view wx:elif="{{errorText}}" class="flow-state flow-state--error">
    <text class="flow-state__title">挑战参数读取失败</text>
    <text class="flow-state__text">{{errorText}}</text>
    <yh-button text="重新读取" variant="secondary" block bind:tap="retryLoad" />
  </view>

  <view wx:else class="flow-stack">
    <yh-panel title="挑战底分" subtitle="选择本场风险积分底数" marker="BASE" tone="orange" raised>
      <view class="points-choice-grid points-choice-grid--base">
          <view
            wx:for="{{mode.baseOptions}}"
            wx:key="*this"
            class="points-choice {{selectedBase === item ? 'is-active' : ''}}"
            data-value="{{item}}"
            bindtap="chooseBase"
            hover-class="points-choice--hover"
          >
            <text class="points-choice__label">底分</text>
            <text class="points-choice__value">{{item}}</text>
          </view>
      </view>
    </yh-panel>

    <yh-panel title="积分倍率" subtitle="倍率越高，胜负积分变化越大" marker="ODDS" tone="default" raised>
      <view class="points-choice-grid points-choice-grid--odds">
          <view
            wx:for="{{mode.multipliers}}"
            wx:key="*this"
            class="points-choice points-choice--odds {{selectedMultiplier === item ? 'is-active' : ''}}"
            data-value="{{item}}"
            bindtap="chooseMultiplier"
            hover-class="points-choice--hover"
          >
            <text class="points-choice__label">倍率</text>
            <text class="points-choice__value">x{{item}}</text>
          </view>
      </view>
    </yh-panel>

    <yh-panel title="本场风险积分" subtitle="胜方加，败方扣；随机奖励另算" marker="RISK" tone="gold" raised>
      <view class="risk-formula">
        <text>{{selectedBase}}</text>
        <text>×</text>
        <text>{{selectedMultiplier}}</text>
        <text>=</text>
        <text>{{riskPoints}} 分</text>
      </view>
      <view class="reward-preview">
        <view>
          <text>普通随机奖励</text>
          <text>{{mode.normalReward}} 分</text>
        </view>
        <view>
          <text>续时冲刺奖励</text>
          <text>{{mode.sprintReward}} 分</text>
        </view>
      </view>
    </yh-panel>

    <view class="flow-actions">
      <yh-button text="确认参数" size="md" variant="primary" block custom-class="points-confirm-button" bind:tap="next" />
    </view>
  </view>
</view>
