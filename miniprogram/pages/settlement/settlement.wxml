<view class="flow-page flow-page--locked">
  <view class="flow-hero flow-hero--compact">
    <text class="flow-hero__eyebrow">SETTLEMENT</text>
    <text class="flow-hero__title">{{previewTitle}}</text>
    <text class="flow-hero__subtitle">{{previewSubtitle}}</text>
  </view>

  <view wx:if="{{previewStatus === 'ready' && settlement}}" class="flow-stack">
    <victory-banner subtitle="胜方 · {{settlement.winner.name}}" />

    <yh-panel title="本场积分" subtitle="随机奖励双方同享，确认后立即计入排行" marker="POINTS" tone="gold" raised>
      <view class="metric-grid">
        <view class="metric-card">
          <text>风险积分</text>
          <text>{{settlement.riskPoints}}</text>
        </view>
        <view class="metric-card">
          <text>{{settlement.winner.shortName}}方变化</text>
          <text>{{settlement.winnerDeltaText}}</text>
        </view>
        <view class="metric-card">
          <text>{{settlement.loser.shortName}}方变化</text>
          <text>{{settlement.loserDeltaText}}</text>
        </view>
      </view>
    </yh-panel>

    <reward-crate type="normal" title="本场随机奖励" range="+{{settlement.rewardValue}} 积分" subtitle="奖励范围 {{settlement.rewardRange}}，双方同享" />

    <yh-panel title="段位星级" subtitle="全部玩法共用一个段位" marker="RANK" tone="orange">
      <view class="metric-grid">
        <view class="metric-card">
          <text>胜方加星</text>
          <text>{{settlement.starRewardText}}</text>
        </view>
        <view class="metric-card">
          <text>当前段位</text>
          <text>{{settlement.winner.rankTitle}}</text>
        </view>
        <view class="metric-card">
          <text>胜方积分</text>
          <text>{{settlement.winnerAfterPoints}}</text>
        </view>
      </view>
    </yh-panel>

    <accept-stamp label="{{settlement.loser.name}} 确认后生效" />

    <view class="flow-actions">
      <yh-button text="服了，确认结算" size="lg" variant="success" block loading="{{settling}}" disabled="{{settling}}" bind:tap="confirm" />
      <yh-button text="不服，暂不结算" variant="danger" block disabled="{{settling}}" bind:tap="refuse" />
    </view>
  </view>

  <view wx:elif="{{previewStatus === 'loading'}}" class="flow-stack">
    <yh-panel title="正在计算预览" subtitle="请保持当前页面打开" marker="SYNC" tone="gold" raised>
      <view class="settlement-state">
        <view class="settlement-state__pulse"></view>
        <text class="settlement-state__title">读取服务端结算预览</text>
        <text class="settlement-state__text">确认前只展示预览，最终积分以确认后写入的结算单为准。</text>
      </view>
    </yh-panel>
  </view>

  <view wx:else class="flow-stack">
    <yh-panel title="不能结算" subtitle="本场暂时无法生成有效预览" marker="CHECK" tone="warn" raised>
      <view class="settlement-state settlement-state--error">
        <text class="settlement-state__title">{{previewTitle}}</text>
        <text class="settlement-state__text">{{previewErrorText}}</text>
      </view>
    </yh-panel>

    <view class="flow-actions">
      <yh-button text="重新计算" size="lg" variant="primary" block loading="{{previewing}}" disabled="{{previewing}}" bind:tap="retryPreview" />
      <yh-button text="回到首页" variant="secondary" block bind:tap="goHome" />
    </view>
  </view>
</view>
