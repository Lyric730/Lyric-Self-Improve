@import "../../styles/player-flow.wxss";

.setup-owner-page {
  padding-bottom: 72rpx;
}

.setup-status,
.setup-form {
  display: grid;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.setup-status > view,
.setup-field,
.setup-message {
  display: grid;
  gap: 8rpx;
  min-width: 0;
  padding: 18rpx;
  background:
    linear-gradient(180deg, rgba(34, 25, 18, 0.9), rgba(8, 7, 6, 0.88)),
    repeating-linear-gradient(135deg, rgba(255, 239, 214, 0.03) 0 2rpx, transparent 2rpx 18rpx);
  border: 1rpx solid rgba(255, 214, 145, 0.14);
  box-sizing: border-box;
  clip-path: polygon(12rpx 0, 100% 0, 100% calc(100% - 12rpx), calc(100% - 12rpx) 100%, 0 100%, 0 12rpx);
}

.setup-status text:first-child,
.setup-field > text {
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 900;
}

.setup-status text:last-child {
  color: var(--yh-color-gold-bright);
  font-size: var(--yh-text-sm);
  font-weight: 900;
  word-break: break-all;
}

.setup-field input {
  min-height: 58rpx;
  color: var(--yh-color-text);
  font-size: var(--yh-text-md);
  font-weight: 900;
}

.setup-message {
  margin: 16rpx 0;
  font-size: var(--yh-text-sm);
  font-weight: 900;
}

.setup-message--error {
  color: var(--yh-color-danger);
  border-color: rgba(239, 77, 50, 0.32);
}

.setup-message--success {
  color: var(--yh-color-gold-bright);
  border-color: rgba(255, 219, 122, 0.32);
}
