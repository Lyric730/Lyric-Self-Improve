<view wx:if="{{accessReady}}" class="flow-page flow-page--locked staff-page">
  <view class="flow-hero flow-hero--compact">
    <text class="flow-hero__eyebrow">STAFF DESK</text>
    <text class="flow-hero__title">前台工作台</text>
    <text class="flow-hero__subtitle">开台到点 · 积分核销 · 异常处理</text>
  </view>

  <view class="flow-stack">
    <yh-panel title="今日球桌" subtitle="选择球桌后设置开台到点时间" marker="TABLE" tone="orange" raised>
      <view class="staff-table-grid">
        <view
          wx:for="{{staffTables}}"
          wx:key="id"
          class="staff-table {{selectedTableId === item.id ? 'is-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="chooseTable"
        >
          <text>{{item.name}}</text>
          <text>到点 {{item.dueTime}}</text>
          <text>{{item.status}}</text>
        </view>
      </view>
    </yh-panel>

    <yh-panel title="{{selectedTable.name}} 到点时间" subtitle="只需要和开台软件到点时间保持一致" marker="DUE TIME" tone="gold">
      <picker mode="time" value="{{selectedTime}}" start="00:00" end="23:59" bindchange="chooseDueTime">
        <view class="due-time-picker" hover-class="due-time-picker--hover">
          <view>
            <text>24 小时制</text>
            <text>选择几点几分</text>
          </view>
          <text>{{selectedTime}}</text>
        </view>
      </picker>
      <view class="member-select member-select--table-open">
        <view class="member-card {{tableOpenMember ? 'is-active' : ''}}">
          <text>{{tableOpenMember ? tableOpenMember.name : '未绑定开台会员'}}</text>
          <text>{{tableOpenMemberText}}</text>
        </view>
        <yh-button text="扫码绑定" size="sm" variant="secondary" custom-class="staff-scan-button" loading="{{scanningTableOpenMember}}" bind:tap="scanTableOpenMember" />
      </view>
      <view class="flow-actions">
        <yh-button text="保存到点时间" size="sm" variant="primary" block custom-class="staff-primary-action" loading="{{savingDue}}" bind:tap="saveDueTime" />
      </view>
    </yh-panel>

    <yh-panel title="前台积分核销" subtitle="{{selectedMemberText}}" marker="EXCHANGE">
      <view class="member-select">
        <view class="member-card {{selectedMember ? 'is-active' : ''}}">
          <text>{{selectedMember ? selectedMember.name : '未选择会员'}}</text>
          <text>{{selectedMember ? '积分账户已匹配' : '扫描会员码后核销积分'}}</text>
        </view>
        <yh-button text="扫码选择" size="sm" variant="secondary" custom-class="staff-scan-button" loading="{{scanningMember}}" bind:tap="scanMember" />
      </view>
      <view class="deduct-input-card">
        <view>
          <text>扣除积分</text>
          <text>{{selectedMember ? '输入本次前台兑换要扣除的分数' : '先扫码选择会员，再填写扣除分数'}}</text>
        </view>
        <view class="deduct-input-box">
          <text>-</text>
          <input
            class="deduct-input"
            type="number"
            value="{{deductPointsInput}}"
            placeholder="0"
            placeholder-class="deduct-input__placeholder"
            maxlength="6"
            bindinput="handleDeductInput"
          />
          <text>分</text>
        </view>
      </view>
      <view class="flow-actions">
        <yh-button text="确认核销" size="sm" variant="success" block custom-class="staff-primary-action" disabled="{{!selectedMember || !deductPoints}}" loading="{{deducting}}" bind:tap="confirmDeduct" />
      </view>
    </yh-panel>

    <yh-panel title="异常比赛" subtitle="只处理退出、再战、作废和备注" marker="REVIEW" tone="danger">
      <view class="staff-issue" wx:for="{{abnormalMatches}}" wx:key="id">
        <view>
          <text>{{item.tableNo}} · {{item.title}}</text>
          <text>{{item.detail}}</text>
        </view>
        <text>{{item.time}}</text>
      </view>
      <view class="flow-actions">
        <yh-button text="作废当前异常" size="sm" variant="danger" block custom-class="staff-primary-action" loading="{{voiding}}" bind:tap="voidMatch" />
      </view>
    </yh-panel>
  </view>
</view>
