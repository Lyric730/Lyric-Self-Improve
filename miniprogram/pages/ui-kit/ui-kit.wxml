<view class="ui-kit-page">
  <view class="hero">
    <view>
      <text class="hero__eyebrow">YUNHAN BILLIARDS CLUB</text>
      <text class="hero__title">球房夜赛控制台</text>
      <text class="hero__copy">按 07 号设计稿逐组件还原 · 当前：01 按钮 / 02 模式卡片</text>
    </view>
    <view class="hero__table">
      <text class="hero__table-label">TABLE</text>
      <text class="hero__table-no">T03</text>
      <text class="hero__table-time">到点 22:30</text>
    </view>
  </view>

  <view class="kit-panel">
    <view class="kit-panel__head">
      <text class="kit-panel__index">01</text>
      <view>
        <text class="kit-panel__title">按钮</text>
        <text class="kit-panel__sub">BUTTONS · 对应设计稿左上区域</text>
      </view>
    </view>

    <view class="button-zone">
      <view class="button-group">
        <text class="button-group__title">主要按钮</text>
        <view class="button-row button-row--primary">
          <view class="button-sample button-sample--wide">
            <yh-button text="开始挑战" variant="primary" block="{{true}}" bind:tap="noop" />
            <text>默认</text>
          </view>
          <view class="button-sample button-sample--wide">
            <yh-button text="开始挑战" variant="primary" block="{{true}}" bind:tap="noop" />
            <text>按下</text>
          </view>
          <view class="button-sample button-sample--wide">
            <yh-button text="开始挑战" variant="primary" disabled="{{true}}" block="{{true}}" bind:tap="noop" />
            <text>禁用</text>
          </view>
        </view>
      </view>

      <view class="button-group">
        <text class="button-group__title">次要 / 提示按钮</text>
        <view class="button-row button-row--primary">
          <view class="button-sample button-sample--wide">
            <yh-button text="临近到点提示" variant="secondary" block="{{true}}" bind:tap="noop" />
            <text>默认</text>
          </view>
          <view class="button-sample button-sample--wide">
            <yh-button text="临近到点提示" variant="warning" block="{{true}}" bind:tap="noop" />
            <text>强调</text>
          </view>
          <view class="button-sample button-sample--wide">
            <yh-button text="临近到点提示" variant="secondary" disabled="{{true}}" block="{{true}}" bind:tap="noop" />
            <text>禁用</text>
          </view>
        </view>
      </view>

      <view class="button-group">
        <text class="button-group__title">对局结果按钮</text>
        <view class="result-row">
          <view class="button-sample">
            <yh-button text="不服" variant="danger" block="{{true}}" bind:tap="noop" />
            <text>默认</text>
          </view>
          <view class="button-sample">
            <yh-button text="不服" variant="danger" disabled="{{true}}" block="{{true}}" bind:tap="noop" />
            <text>禁用</text>
          </view>
          <view class="button-sample">
            <yh-button text="服了确认" variant="success" block="{{true}}" bind:tap="noop" />
            <text>默认</text>
          </view>
          <view class="button-sample">
            <yh-button text="服了确认" variant="success" disabled="{{true}}" block="{{true}}" bind:tap="noop" />
            <text>禁用</text>
          </view>
        </view>
      </view>

      <view class="button-group">
        <text class="button-group__title">图标按钮</text>
        <view class="icon-row">
          <view class="icon-sample">
            <yh-button icon="+" variant="icon" icon-only="{{true}}" bind:tap="noop" />
            <text>默认</text>
          </view>
          <view class="icon-sample">
            <yh-button icon="+" variant="warning" icon-only="{{true}}" bind:tap="noop" />
            <text>按下</text>
          </view>
          <view class="icon-sample">
            <yh-button icon="+" variant="icon" icon-only="{{true}}" disabled="{{true}}" bind:tap="noop" />
            <text>禁用</text>
          </view>
          <view class="icon-sample">
            <yh-button icon="-" variant="icon" icon-only="{{true}}" bind:tap="noop" />
            <text>默认</text>
          </view>
          <view class="icon-sample">
            <yh-button icon="‹" variant="icon" icon-only="{{true}}" bind:tap="noop" />
            <text>返回</text>
          </view>
          <view class="icon-sample">
            <yh-button icon="?" variant="icon" icon-only="{{true}}" bind:tap="noop" />
            <text>规则</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="kit-panel">
    <view class="kit-panel__head">
      <text class="kit-panel__index">02</text>
      <view>
        <text class="kit-panel__title">模式卡片</text>
        <text class="kit-panel__sub">MODE CARDS · 对应设计稿上中区域</text>
      </view>
    </view>

    <view class="mode-grid">
      <mode-card
        wx:for="{{modes}}"
        wx:key="modeId"
        mode-id="{{item.modeId}}"
        name="{{item.name}}"
        target-wins="{{item.targetWins}}"
        minimum-minutes="{{item.minimumMinutes}}"
        base-options="{{item.baseOptions}}"
        star-reward="{{item.starReward}}"
        enabled="{{item.enabled}}"
        selected="{{selectedMode === item.modeId}}"
        tag="{{item.tag}}"
        bind:select="handleModeSelect"
      />
    </view>
  </view>
</view>
