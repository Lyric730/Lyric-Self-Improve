<view class="ui-kit-page">
  <view class="hero">
    <view>
      <text class="hero__eyebrow">YUNHAN BILLIARDS CLUB</text>
      <text class="hero__title">球房夜赛控制台</text>
      <text class="hero__copy">按 07 号设计稿逐组件还原 · 当前：01 按钮 / 02 模式卡片 / 03 底分倍率 / 04 计分控件 / 05 随机奖励</text>
    </view>
    <view class="hero__table">
      <text class="hero__table-label">TABLE</text>
      <text class="hero__table-no">T03</text>
      <text class="hero__table-time">到点 22:30</text>
    </view>
  </view>

  <view class="kit-panel kit-panel--buttons">
    <view class="kit-panel__head">
      <text class="kit-panel__index">01</text>
      <view>
        <text class="kit-panel__title">按钮</text>
        <text class="kit-panel__sub">BUTTONS · 对应设计稿左上区域</text>
      </view>
    </view>

    <view class="button-zone">
      <view class="button-group">
        <text class="button-group__title">主要按钮</text>
        <view class="button-row button-row--primary">
          <view class="button-sample button-sample--wide">
            <yh-button text="开始挑战" variant="primary" block="{{true}}" bindtap="noop"></yh-button>
            <text>默认</text>
          </view>
          <view class="button-sample button-sample--wide">
            <yh-button text="开始挑战" variant="primary" block="{{true}}" bindtap="noop"></yh-button>
            <text>按下</text>
          </view>
          <view class="button-sample button-sample--wide">
            <yh-button text="开始挑战" variant="primary" disabled="{{true}}" block="{{true}}" bindtap="noop"></yh-button>
            <text>禁用</text>
          </view>
        </view>
      </view>

      <view class="button-group">
        <text class="button-group__title">次要 / 提示按钮</text>
        <view class="button-row button-row--primary">
          <view class="button-sample button-sample--wide">
            <yh-button text="临近到点提示" variant="secondary" block="{{true}}" bindtap="noop"></yh-button>
            <text>默认</text>
          </view>
          <view class="button-sample button-sample--wide">
            <yh-button text="临近到点提示" variant="warning" block="{{true}}" bindtap="noop"></yh-button>
            <text>强调</text>
          </view>
          <view class="button-sample button-sample--wide">
            <yh-button text="临近到点提示" variant="secondary" disabled="{{true}}" block="{{true}}" bindtap="noop"></yh-button>
            <text>禁用</text>
          </view>
        </view>
      </view>

      <view class="button-group">
        <text class="button-group__title">对局结果按钮</text>
        <view class="result-row">
          <view class="button-sample">
            <yh-button text="不服" variant="danger" block="{{true}}" bindtap="noop"></yh-button>
            <text>默认</text>
          </view>
          <view class="button-sample">
            <yh-button text="不服" variant="danger" disabled="{{true}}" block="{{true}}" bindtap="noop"></yh-button>
            <text>禁用</text>
          </view>
          <view class="button-sample">
            <yh-button text="服了确认" variant="success" block="{{true}}" bindtap="noop"></yh-button>
            <text>默认</text>
          </view>
          <view class="button-sample">
            <yh-button text="服了确认" variant="success" disabled="{{true}}" block="{{true}}" bindtap="noop"></yh-button>
            <text>禁用</text>
          </view>
        </view>
      </view>

      <view class="button-group">
        <text class="button-group__title">图标按钮</text>
        <view class="icon-row">
          <view class="icon-sample">
            <yh-button icon="+" variant="icon" icon-only="{{true}}" bindtap="noop"></yh-button>
            <text>默认</text>
          </view>
          <view class="icon-sample">
            <yh-button icon="+" variant="warning" icon-only="{{true}}" bindtap="noop"></yh-button>
            <text>按下</text>
          </view>
          <view class="icon-sample">
            <yh-button icon="+" variant="icon" icon-only="{{true}}" disabled="{{true}}" bindtap="noop"></yh-button>
            <text>禁用</text>
          </view>
          <view class="icon-sample">
            <yh-button icon="-" variant="icon" icon-only="{{true}}" bindtap="noop"></yh-button>
            <text>默认</text>
          </view>
          <view class="icon-sample">
            <yh-button icon="‹" variant="icon" icon-only="{{true}}" bindtap="noop"></yh-button>
            <text>返回</text>
          </view>
          <view class="icon-sample">
            <yh-button icon="?" variant="icon" icon-only="{{true}}" bindtap="noop"></yh-button>
            <text>规则</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="kit-panel kit-panel--modes">
    <view class="kit-panel__head">
      <text class="kit-panel__index">02</text>
      <view>
        <text class="kit-panel__title">模式卡片</text>
        <text class="kit-panel__sub">MODE CARDS · 对应设计稿上中区域</text>
      </view>
    </view>

    <view class="mode-grid">
      <mode-card
        wx:for="{{modes}}"
        wx:key="modeId"
        mode-id="{{item.modeId}}"
        name="{{item.name}}"
        target-wins="{{item.targetWins}}"
        minimum-minutes="{{item.minimumMinutes}}"
        base-options="{{item.baseOptions}}"
        star-reward="{{item.starReward}}"
        enabled="{{item.enabled}}"
        selected="{{item.selected}}"
        tag="{{item.tag}}"
        bindselect="handleModeSelect"></mode-card>
    </view>
  </view>

  <view class="kit-panel kit-panel--selectors">
    <view class="kit-panel__head">
      <text class="kit-panel__index">03</text>
      <view>
        <text class="kit-panel__title">底分 / 倍率选择</text>
        <text class="kit-panel__sub">SELECTORS · 对应设计稿右上区域</text>
      </view>
    </view>

    <point-selector
      base-options="{{selectorBaseOptions}}"
      multipliers="{{selectorMultipliers}}"
      selected-base="{{selectedBase}}"
      selected-multiplier="{{selectedMultiplier}}"
      reward-range="80 ~ 150"
      sprint-reward-range="200 ~ 300"
      bindchange="handlePointChange"></point-selector>
  </view>

  <view class="kit-panel kit-panel--score">
    <view class="kit-panel__head">
      <text class="kit-panel__index">04</text>
      <view>
        <text class="kit-panel__title">计分与比分控件</text>
        <text class="kit-panel__sub">SCORE CONTROLS · 对应设计稿中左区域</text>
      </view>
    </view>

    <score-control
      player-a-name="云瀚·阿杰"
      player-b-name="台球小宇"
      score-a="{{5}}"
      score-b="{{3}}"
      target-wins="{{5}}"
      current-rack="{{8}}"
      due-time="22:30"
      elapsed-label="00:28:35"
      minimum-label="40:00"
      remaining-label="11:25"></score-control>
  </view>

  <view class="kit-panel kit-panel--reward">
    <view class="kit-panel__head">
      <text class="kit-panel__index">05</text>
      <view>
        <text class="kit-panel__title">随机奖励宝箱</text>
        <text class="kit-panel__sub">REWARD CRATE · 对应设计稿右中区域</text>
      </view>
    </view>

    <reward-crate
      normal-range="80 ~ 150"
      sprint-range="200 ~ 300"
      current-stage="{{4}}"
      cycle-label="第 4 大局"
      due-label="到点前冲刺"
      boost-percent="{{200}}"
      bindstagechange="noop"></reward-crate>
  </view>
</view>
