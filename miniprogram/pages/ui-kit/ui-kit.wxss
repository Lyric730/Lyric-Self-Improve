@import "../../styles/tokens.wxss";

.ui-kit-page {
  min-height: 100vh;
  padding: var(--yh-page-pad);
  background:
    radial-gradient(circle at 92% 0, rgba(255, 118, 0, 0.18), transparent 230rpx),
    linear-gradient(145deg, var(--yh-color-bg), var(--yh-color-bg-2) 52%, #070604);
  box-sizing: border-box;
}

.hero {
  position: relative;
  display: flex;
  justify-content: space-between;
  gap: var(--yh-space-4);
  padding: var(--yh-space-5) 0 var(--yh-space-4);
}

.hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(255, 118, 0, 0.7), transparent);
}

.hero__eyebrow {
  display: block;
  color: var(--yh-color-orange);
  font-size: var(--yh-text-xs);
  font-weight: 900;
  letter-spacing: 0.18em;
}

.hero__title {
  display: block;
  margin-top: var(--yh-space-1);
  color: var(--yh-color-text);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.04;
}

.hero__copy {
  display: block;
  max-width: 430rpx;
  margin-top: var(--yh-space-2);
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  line-height: 1.45;
}

.hero__table {
  flex: 0 0 168rpx;
  align-self: flex-start;
  padding: var(--yh-space-2);
  background: rgba(255, 118, 0, 0.1);
  box-shadow: inset 0 0 0 1rpx var(--yh-color-line-strong);
  text-align: right;
  clip-path: polygon(18rpx 0, 100% 0, 100% calc(100% - 18rpx), calc(100% - 18rpx) 100%, 0 100%, 0 18rpx);
}

.hero__table-label,
.hero__table-time {
  display: block;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
}

.hero__table-no {
  display: block;
  color: var(--yh-color-gold-bright);
  font-family: var(--yh-font-number);
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.kit-panel {
  position: relative;
  margin-top: var(--yh-space-4);
  padding: 18rpx;
  overflow: hidden;
  background:
    linear-gradient(150deg, rgba(31, 25, 18, 0.96), rgba(11, 11, 10, 0.98)),
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.025) 0 2rpx, transparent 2rpx 26rpx);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 118, 0, 0.42),
    0 16rpx 34rpx rgba(0, 0, 0, 0.32);
  clip-path: polygon(18rpx 0, calc(100% - 18rpx) 0, 100% 18rpx, 100% 100%, 0 100%, 0 18rpx);
}

.kit-panel__head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.kit-panel__index {
  color: var(--yh-color-orange);
  font-family: var(--yh-font-number);
  font-size: 38rpx;
  font-weight: 900;
}

.kit-panel__title {
  display: block;
  color: var(--yh-color-gold-bright);
  font-size: var(--yh-text-md);
  font-weight: 900;
}

.kit-panel__sub {
  display: block;
  margin-top: 4rpx;
  color: var(--yh-color-text-faint);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.button-zone {
  display: grid;
  gap: 24rpx;
}

.button-group {
  display: grid;
  gap: 12rpx;
}

.button-group__title {
  color: #a77942;
  font-size: 22rpx;
  font-weight: 900;
}

.button-row,
.result-row,
.icon-row {
  display: grid;
  gap: 14rpx;
}

.button-row--primary {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.result-row {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.icon-row {
  grid-template-columns: repeat(6, minmax(0, 1fr));
  align-items: start;
}

.button-sample,
.icon-sample {
  display: grid;
  gap: 8rpx;
  justify-items: center;
  min-width: 0;
}

.button-sample {
  justify-items: stretch;
}

.button-sample > text,
.icon-sample > text {
  color: #7d7164;
  font-size: 18rpx;
  font-weight: 700;
  text-align: center;
}

.mode-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}
