@import "../../styles/tokens.wxss";

.ui-kit-page {
  min-height: 100vh;
  padding: 36rpx 28rpx 72rpx;
  background:
    radial-gradient(circle at 88% 0, rgba(255, 118, 0, 0.13), transparent 260rpx),
    linear-gradient(145deg, var(--yh-color-bg), var(--yh-color-bg-2) 52%, #070604),
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.018) 0 2rpx, transparent 2rpx 34rpx);
  box-sizing: border-box;
}

.hero {
  position: relative;
  display: flex;
  justify-content: space-between;
  gap: var(--yh-space-4);
  padding: 54rpx 0 56rpx;
}

.hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(255, 118, 0, 0.7), transparent);
}

.hero__eyebrow {
  display: block;
  color: var(--yh-color-orange);
  font-size: var(--yh-text-xs);
  font-weight: 900;
  letter-spacing: 0.18em;
}

.hero__title {
  display: block;
  margin-top: var(--yh-space-1);
  color: var(--yh-color-text);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.04;
}

.hero__copy {
  display: block;
  max-width: 430rpx;
  margin-top: var(--yh-space-2);
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  line-height: 1.45;
}

.hero__table {
  flex: 0 0 168rpx;
  align-self: flex-start;
  padding: var(--yh-space-2);
  background: rgba(255, 118, 0, 0.1);
  box-shadow: inset 0 0 0 1rpx var(--yh-color-line-strong);
  text-align: right;
  clip-path: polygon(18rpx 0, calc(100% - 18rpx) 0, 100% 18rpx, 100% calc(100% - 18rpx), calc(100% - 18rpx) 100%, 18rpx 100%, 0 calc(100% - 18rpx), 0 18rpx);
}

.hero__table-label,
.hero__table-time {
  display: block;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
}

.hero__table-no {
  display: block;
  color: var(--yh-color-gold-bright);
  font-family: var(--yh-font-number);
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.kit-panel {
  position: relative;
  margin-top: 52rpx;
  padding: 26rpx;
  overflow: hidden;
  background:
    linear-gradient(150deg, rgba(25, 20, 15, 0.95), rgba(9, 9, 8, 0.99)),
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.02) 0 2rpx, transparent 2rpx 28rpx);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 118, 0, 0.36),
    inset 0 0 0 3rpx rgba(255, 211, 107, 0.035),
    0 16rpx 30rpx rgba(0, 0, 0, 0.28);
  clip-path: polygon(22rpx 0, calc(100% - 22rpx) 0, 100% 22rpx, 100% calc(100% - 22rpx), calc(100% - 22rpx) 100%, 22rpx 100%, 0 calc(100% - 22rpx), 0 22rpx);
}

.kit-panel::before,
.kit-panel::after {
  content: "";
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 118, 0, 0.62), transparent);
  pointer-events: none;
}

.kit-panel::before {
  top: 12rpx;
}

.kit-panel::after {
  bottom: 12rpx;
}

.kit-panel__head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.kit-panel__index {
  color: var(--yh-color-orange);
  font-family: var(--yh-font-number);
  font-size: 38rpx;
  font-weight: 900;
}

.kit-panel__title {
  display: block;
  color: var(--yh-color-gold-bright);
  font-size: var(--yh-text-md);
  font-weight: 900;
}

.kit-panel__sub {
  display: block;
  margin-top: 4rpx;
  color: var(--yh-color-text-faint);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.button-zone {
  display: flex;
  flex-direction: column;
  gap: 34rpx;
}

.button-group {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.button-group__title {
  color: #a77942;
  font-size: 22rpx;
  font-weight: 900;
}

.button-row,
.result-row,
.icon-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.button-row--primary .button-sample {
  flex: 1 1 190rpx;
}

.result-row .button-sample {
  flex: 1 1 240rpx;
}

.icon-row {
  align-items: start;
}

.button-sample,
.icon-sample {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
  min-width: 0;
}

.button-sample {
  align-items: stretch;
}

.button-sample > text,
.icon-sample > text {
  color: #7d7164;
  font-size: 18rpx;
  font-weight: 700;
  text-align: center;
}

.mode-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
}

.mode-grid mode-card {
  flex: 1 1 190rpx;
}
