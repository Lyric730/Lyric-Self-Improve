@import "../../styles/player-flow.wxss";

.room-ticket {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 152rpx;
  gap: var(--yh-space-3);
  padding: 30rpx 26rpx;
  overflow: hidden;
  background:
    linear-gradient(128deg, rgba(39, 28, 18, 0.98), rgba(9, 8, 6, 0.98) 58%, rgba(74, 28, 0, 0.86)),
    repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 2rpx, transparent 2rpx 26rpx);
  border: 1rpx solid rgba(255, 136, 22, 0.4);
  box-shadow: var(--yh-shadow-panel);
  clip-path: polygon(24rpx 0, calc(100% - 20rpx) 0, 100% 20rpx, 100% calc(100% - 24rpx), calc(100% - 24rpx) 100%, 0 100%, 0 24rpx);
}

.room-ticket__label,
.room-ticket__code,
.room-ticket__hint,
.room-ticket__table text,
.room-status text {
  display: block;
}

.room-ticket__label {
  color: var(--yh-color-orange);
  font-size: var(--yh-text-xs);
  font-weight: 900;
  letter-spacing: 0.14em;
}

.room-ticket__code {
  margin-top: 12rpx;
  color: var(--yh-color-text);
  font-family: var(--yh-font-number);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.05;
}

.room-ticket__hint {
  margin-top: 14rpx;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  font-weight: 800;
}

.room-ticket__table {
  display: grid;
  align-content: center;
  justify-items: end;
}

.room-ticket__table text:first-child {
  color: var(--yh-color-text-faint);
  font-size: var(--yh-text-xs);
  font-style: italic;
  font-weight: 900;
}

.room-ticket__table text:last-child {
  color: rgba(246, 239, 230, 0.18);
  font-family: var(--yh-font-number);
  font-size: 74rpx;
  font-weight: 900;
  line-height: 1;
}

.player-card--horizontal {
  grid-template-columns: 86rpx minmax(0, 1fr);
  justify-items: start;
  align-items: center;
  text-align: left;
}

.player-card--horizontal .player-card__name,
.player-card--horizontal .player-card__rank {
  text-align: left;
}

.room-status {
  display: grid;
  grid-template-columns: 20rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 20rpx 22rpx;
  background: rgba(8, 7, 6, 0.68);
  border: 1rpx solid rgba(255, 214, 145, 0.14);
  clip-path: polygon(14rpx 0, 100% 0, 100% calc(100% - 14rpx), calc(100% - 14rpx) 100%, 0 100%, 0 14rpx);
}

.room-status__dot {
  width: 18rpx;
  height: 18rpx;
  background: var(--yh-color-orange);
  border-radius: 999rpx;
  box-shadow: 0 0 18rpx rgba(255, 118, 0, 0.46);
}

.room-status__dot.is-ready {
  background: var(--yh-color-gold-bright);
  box-shadow: 0 0 18rpx rgba(255, 210, 116, 0.46);
}

.room-status text:first-child {
  color: var(--yh-color-text);
  font-size: var(--yh-text-md);
  font-weight: 900;
}

.room-status text:last-child {
  margin-top: 6rpx;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 800;
}
