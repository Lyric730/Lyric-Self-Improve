@import "./tokens.wxss";
@import "./motion.wxss";

.flow-page {
  position: relative;
  min-height: 100vh;
  padding: 28rpx var(--yh-page-pad) 148rpx;
  color: var(--yh-color-text);
  background:
    radial-gradient(circle at 14% 0%, rgba(116, 64, 30, 0.34), transparent 310rpx),
    radial-gradient(circle at 88% 12%, rgba(255, 122, 0, 0.16), transparent 250rpx),
    linear-gradient(155deg, rgba(86, 45, 20, 0.38), transparent 42%),
    var(--yh-color-bg);
}

.flow-page::before {
  content: "";
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  height: 148rpx;
  opacity: 0.52;
  background:
    linear-gradient(90deg, rgba(116, 64, 30, 0.72), rgba(61, 28, 12, 0.12) 34%, transparent),
    repeating-linear-gradient(90deg, rgba(255, 220, 164, 0.055) 0 2rpx, transparent 2rpx 52rpx);
  pointer-events: none;
}

.flow-page--locked {
  padding-bottom: 48rpx;
}

.flow-hero {
  position: relative;
  min-height: 228rpx;
  padding: 34rpx 28rpx;
  overflow: hidden;
  background:
    linear-gradient(125deg, rgba(38, 24, 14, 0.86) 0 38%, rgba(94, 48, 21, 0.62) 38% 66%, rgba(255, 122, 0, 0.26) 66% 100%),
    linear-gradient(180deg, rgba(62, 43, 27, 0.94), rgba(18, 13, 9, 0.97));
  border: 1rpx solid rgba(255, 193, 99, 0.2);
  clip-path: polygon(0 0, calc(100% - 36rpx) 0, 100% 36rpx, 100% 100%, 32rpx 100%, 0 calc(100% - 32rpx));
  box-shadow: var(--yh-shadow-panel);
  animation: yh-flow-enter var(--yh-motion-slow) var(--yh-ease-out) both;
}

.flow-hero--compact {
  min-height: 170rpx;
}

.flow-hero__eyebrow,
.flow-hero__title,
.flow-hero__subtitle,
.flow-table text {
  position: relative;
  z-index: 1;
  display: block;
}

.flow-hero__eyebrow {
  color: var(--yh-color-orange);
  font-size: var(--yh-text-xs);
  font-weight: 900;
  letter-spacing: 0.16em;
}

.flow-hero__title {
  margin-top: 12rpx;
  color: var(--yh-color-text);
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.05;
}

.flow-hero__subtitle {
  margin-top: 16rpx;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  font-weight: 800;
}

.flow-table {
  position: absolute;
  top: 34rpx;
  right: 28rpx;
  z-index: 1;
  text-align: right;
}

.flow-table text:first-child {
  color: var(--yh-color-text-faint);
  font-size: var(--yh-text-xs);
  font-style: italic;
  font-weight: 900;
}

.flow-table text:last-child {
  color: rgba(246, 239, 230, 0.12);
  font-family: var(--yh-font-number);
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
}

.flow-stack {
  display: grid;
  gap: var(--yh-space-4);
  margin-top: var(--yh-space-4);
  animation: yh-flow-enter var(--yh-motion-slow) var(--yh-ease-out) 80ms both;
}

.flow-actions {
  display: grid;
  gap: var(--yh-space-3);
  margin-top: var(--yh-space-4);
}

.flow-actions--pair {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.flow-note {
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  font-weight: 800;
  line-height: 1.55;
}

.flow-kicker {
  color: var(--yh-color-orange);
  font-size: var(--yh-text-xs);
  font-weight: 900;
  letter-spacing: 0.12em;
}

.flow-title {
  display: block;
  margin-top: 8rpx;
  color: var(--yh-color-text);
  font-size: 44rpx;
  font-weight: 900;
}

.player-strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--yh-space-3);
}

.player-card,
.metric-card,
.notice-card {
  padding: 24rpx;
  background:
    linear-gradient(180deg, rgba(49, 36, 24, 0.82), rgba(18, 13, 9, 0.86)),
    repeating-linear-gradient(135deg, rgba(255, 239, 214, 0.028) 0 2rpx, transparent 2rpx 22rpx);
  border: 1rpx solid rgba(255, 220, 164, 0.18);
  clip-path: polygon(18rpx 0, 100% 0, 100% calc(100% - 18rpx), calc(100% - 18rpx) 100%, 0 100%, 0 18rpx);
}

.avatar-token {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  color: #120804;
  font-size: 36rpx;
  font-weight: 900;
  background:
    radial-gradient(circle at 36% 24%, #ffe3a5, #ff7600 58%, #8f2e00),
    linear-gradient(135deg, rgba(255, 255, 255, 0.28), transparent);
  border: 3rpx solid var(--yh-color-orange);
  border-radius: 999rpx;
}

.avatar-token--blue {
  color: var(--yh-color-text);
  background:
    radial-gradient(circle at 34% 24%, #d7e2f3, #2f5f9f 58%, #0b1b33),
    linear-gradient(135deg, rgba(255, 255, 255, 0.2), transparent);
  border-color: rgba(108, 151, 210, 0.72);
}

.player-card {
  display: grid;
  justify-items: center;
  gap: 10rpx;
  min-width: 0;
}

.player-card__name,
.player-card__meta,
.player-card__rank {
  display: block;
  max-width: 100%;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.player-card__name {
  color: var(--yh-color-text);
  font-size: var(--yh-text-md);
  font-weight: 900;
}

.player-card__meta,
.player-card__rank {
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 800;
}

.mode-stack,
.ranking-list,
.selector-block {
  display: grid;
  gap: var(--yh-space-3);
}

.selector-block__label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--yh-color-gold-bright);
  font-size: var(--yh-text-sm);
  font-weight: 900;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.option-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 68rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  overflow: hidden;
  color: var(--yh-color-text-muted);
  font-family: var(--yh-font-number);
  font-size: var(--yh-text-sm);
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  text-overflow: ellipsis;
  background:
    linear-gradient(180deg, rgba(58, 43, 29, 0.96), rgba(26, 20, 14, 0.98)),
    repeating-linear-gradient(135deg, rgba(255, 239, 214, 0.03) 0 2rpx, transparent 2rpx 18rpx);
  border: 1rpx solid rgba(255, 220, 164, 0.18);
  border-radius: 0;
  clip-path: polygon(12rpx 0, 100% 0, 100% calc(100% - 12rpx), calc(100% - 12rpx) 100%, 0 100%, 0 12rpx);
}

.option-chip::after {
  border: 0;
}

.option-chip.is-active {
  color: #1b0e04;
  background: linear-gradient(180deg, #ffb13c, #ff7600 54%, #9b3600);
  border-color: rgba(255, 211, 107, 0.72);
  box-shadow: var(--yh-glow-orange);
}

.risk-formula {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
  padding: 24rpx;
  color: var(--yh-color-text);
  background:
    linear-gradient(180deg, rgba(77, 45, 24, 0.5), rgba(15, 11, 8, 0.72)),
    repeating-linear-gradient(90deg, rgba(255, 122, 0, 0.04) 0 2rpx, transparent 2rpx 24rpx);
  border: 1rpx solid rgba(255, 122, 0, 0.32);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 220, 164, 0.08),
    0 12rpx 24rpx rgba(0, 0, 0, 0.18);
  clip-path: polygon(16rpx 0, 100% 0, 100% calc(100% - 16rpx), calc(100% - 16rpx) 100%, 0 100%, 0 16rpx);
}

.risk-formula text {
  font-family: var(--yh-font-number);
  font-size: 38rpx;
  font-weight: 900;
}

.risk-formula text:last-child {
  color: var(--yh-color-gold-bright);
  font-size: 48rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--yh-space-2);
}

.metric-card {
  min-height: 118rpx;
}

.metric-card text {
  display: block;
}

.metric-card text:first-child {
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 800;
}

.metric-card text:last-child {
  margin-top: 10rpx;
  color: var(--yh-color-gold-bright);
  font-family: var(--yh-font-number);
  font-size: 36rpx;
  font-weight: 900;
}

.score-arena {
  display: grid;
  gap: var(--yh-space-3);
}

.score-board {
  display: grid;
  grid-template-columns: 118rpx minmax(0, 1fr) 118rpx;
  align-items: center;
  gap: var(--yh-space-2);
  min-height: 222rpx;
  padding: 22rpx;
  background:
    radial-gradient(circle at 50% 34%, rgba(255, 122, 0, 0.24), transparent 190rpx),
    linear-gradient(180deg, rgba(79, 46, 23, 0.56), rgba(17, 12, 8, 0.96)),
    repeating-linear-gradient(90deg, rgba(255, 122, 0, 0.04) 0 2rpx, transparent 2rpx 30rpx);
  border: 1rpx solid rgba(255, 122, 0, 0.38);
  clip-path: polygon(18rpx 0, calc(100% - 18rpx) 0, 100% 18rpx, 100% 100%, 0 100%, 0 18rpx);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 220, 164, 0.08),
    inset 0 -12rpx 0 rgba(0, 0, 0, 0.18),
    0 16rpx 32rpx rgba(0, 0, 0, 0.24);
}

.score-board__side {
  display: grid;
  justify-items: center;
  gap: 10rpx;
}

.score-board__side text {
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 900;
  text-align: center;
}

.score-board__core {
  display: grid;
  justify-items: center;
}

.score-board__number {
  color: var(--yh-color-orange);
  font-family: var(--yh-font-number);
  font-size: 108rpx;
  font-weight: 900;
  line-height: 0.9;
  text-shadow: 0 0 26rpx rgba(255, 118, 0, 0.4);
  animation: yh-score-flash var(--yh-motion-slow) var(--yh-ease-out) both;
}

.score-board__sub {
  margin-top: 12rpx;
  color: var(--yh-color-gold-bright);
  font-size: var(--yh-text-xs);
  font-weight: 900;
}

.stepper-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--yh-space-3);
}

.stepper-box {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 20rpx;
  background: linear-gradient(180deg, rgba(46, 34, 23, 0.76), rgba(17, 13, 9, 0.84));
  border: 1rpx solid rgba(255, 220, 164, 0.16);
  clip-path: polygon(14rpx 0, 100% 0, 100% calc(100% - 14rpx), calc(100% - 14rpx) 100%, 0 100%, 0 14rpx);
}

.stepper-box > text {
  grid-column: 1 / -1;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  font-weight: 900;
  text-align: center;
}

.stepper-button {
  width: 100%;
  min-width: 0;
}

.notice-card {
  display: grid;
  gap: 12rpx;
}

.notice-card text:first-child {
  color: var(--yh-color-danger);
  font-size: var(--yh-text-lg);
  font-weight: 900;
}

.notice-card text:last-child {
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  font-weight: 800;
  line-height: 1.5;
}

.ranking-tabs,
.bottom-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.ranking-tabs text {
  min-height: 64rpx;
  padding-top: 20rpx;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 900;
  text-align: center;
  background: rgba(23, 18, 13, 0.78);
  border: 1rpx solid rgba(255, 220, 164, 0.14);
}

.ranking-tabs text.is-active {
  color: var(--yh-color-orange);
  border-color: rgba(255, 118, 0, 0.62);
}

.ranking-row {
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr) 96rpx 54rpx;
  align-items: center;
  gap: 12rpx;
  min-height: 78rpx;
  padding: 0 16rpx;
  background: linear-gradient(90deg, rgba(36, 27, 18, 0.74), rgba(12, 10, 8, 0.72));
  border: 1rpx solid rgba(255, 220, 164, 0.11);
}

.ranking-row text {
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 900;
}

.ranking-row view {
  min-width: 0;
}

.ranking-row view text {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ranking-row view text:first-child {
  color: var(--yh-color-text);
  font-size: var(--yh-text-sm);
}

.ranking-row > text:nth-child(3),
.ranking-row > text:nth-child(4) {
  color: var(--yh-color-gold-bright);
  font-family: var(--yh-font-number);
  text-align: right;
}

.bottom-tabs {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 20;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  min-height: 96rpx;
  overflow: hidden;
  background: rgba(8, 7, 6, 0.94);
  border: 1rpx solid rgba(255, 214, 145, 0.16);
  clip-path: polygon(22rpx 0, 100% 0, 100% calc(100% - 22rpx), calc(100% - 22rpx) 100%, 0 100%, 0 22rpx);
}

.bottom-tabs text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  font-weight: 900;
}

.bottom-tabs text.is-active {
  color: var(--yh-color-orange);
  background: linear-gradient(180deg, rgba(255, 118, 0, 0.24), rgba(255, 118, 0, 0.08));
}
