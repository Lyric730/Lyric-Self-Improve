<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>${page_title}</title>
  <style>${css}</style>
</head>
<body>
  <article class="page inside" style="--accent-a: ${accent_a}; --accent-b: ${accent_b};">
    <div class="inside-top">
      <div>三分钟未来 / AI HOT</div>
      <div>${date_label}</div>
    </div>

    <div class="photo">${visual}</div>

    <div class="source">${source}</div>

    <div class="title-card">
      <h2 class="inside-title ${title_class}">${title}</h2>
    </div>

    <div class="story content-card">
      <section class="brief-card">
        <span class="module-label">短讯</span>
        <p>${fact}</p>
      </section>
      <section class="think-card">
        <span class="module-label">思考</span>
        <div class="think">${thought}</div>
      </section>
    </div>

    <div class="inside-account-ribbon">
      <span>THREE-MINUTE FUTURE</span>
      <span>${account}</span>
    </div>
  </article>
</body>
</html>
