@import "../../styles/tokens.wxss";

.reward-crate {
  position: relative;
  min-height: 220rpx;
  padding: 24rpx 24rpx 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 118, 0, 0.34);
  background:
    radial-gradient(circle at 78% 18%, rgba(255, 211, 107, 0.2), transparent 190rpx),
    linear-gradient(135deg, rgba(255, 118, 0, 0.12), rgba(12, 9, 7, 0.94));
  clip-path: polygon(0 20rpx, 20rpx 0, 100% 0, 100% calc(100% - 20rpx), calc(100% - 20rpx) 100%, 0 100%);
}

.reward-crate--sprint {
  border-color: rgba(255, 211, 107, 0.5);
  box-shadow: 0 0 28rpx rgba(255, 118, 0, 0.16);
}

.reward-crate__copy {
  position: relative;
  z-index: 2;
}

.reward-crate__title,
.reward-crate__range,
.reward-crate__subtitle {
  display: block;
}

.reward-crate__title {
  color: var(--yh-color-gold-bright);
  font-size: 26rpx;
  font-weight: 900;
}

.reward-crate__range {
  margin-top: 94rpx;
  color: var(--yh-color-text);
  font-family: var(--yh-font-number);
  font-size: 34rpx;
  font-weight: 900;
}

.reward-crate__subtitle {
  margin-top: 8rpx;
  color: var(--yh-color-text-muted);
  font-size: 20rpx;
}

.reward-crate__asset {
  position: absolute;
  top: 38rpx;
  right: 18rpx;
  width: 170rpx;
  height: 142rpx;
  filter: drop-shadow(0 14rpx 24rpx rgba(0, 0, 0, 0.5));
}
