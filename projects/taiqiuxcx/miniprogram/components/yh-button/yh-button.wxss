@import "../../styles/tokens.wxss";
@import "../../styles/motion.wxss";

.yh-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--yh-space-1);
  min-height: 88rpx;
  padding: 0 var(--yh-space-4);
  border: 0;
  border-radius: var(--yh-radius-md);
  overflow: hidden;
  color: var(--yh-color-text);
  font-size: var(--yh-text-md);
  font-weight: 800;
  letter-spacing: 0;
  transition: transform var(--yh-motion-fast) var(--yh-ease-out),
    opacity var(--yh-motion-fast) var(--yh-ease-out),
    box-shadow var(--yh-motion-fast) var(--yh-ease-out);
}

.yh-btn::after {
  border: 0;
}

.yh-btn::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(110deg, transparent 0 18%, rgba(255, 255, 255, 0.14) 42%, transparent 64%);
  opacity: 0;
  transform: translateX(-65%);
  transition: opacity var(--yh-motion-base) var(--yh-ease-out),
    transform var(--yh-motion-base) var(--yh-ease-out);
}

.yh-btn--hover {
  transform: scale(0.98);
  opacity: 0.94;
}

.yh-btn--hover::before {
  opacity: 1;
  transform: translateX(65%);
}

.yh-btn--block {
  display: flex;
  width: 100%;
}

.yh-btn--sm {
  min-height: 64rpx;
  padding: 0 var(--yh-space-3);
  border-radius: var(--yh-radius-sm);
  font-size: var(--yh-text-sm);
}

.yh-btn--lg {
  min-height: 104rpx;
  padding: 0 var(--yh-space-5);
  font-size: var(--yh-text-lg);
}

.yh-btn--primary {
  color: #1a0f08;
  background:
    linear-gradient(135deg, var(--yh-color-orange), var(--yh-color-orange-deep)),
    repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.14) 0 14rpx, transparent 14rpx 28rpx);
  box-shadow: var(--yh-shadow-button), inset 0 2rpx 0 rgba(255, 255, 255, 0.24);
}

.yh-btn--secondary {
  color: var(--yh-color-text);
  background:
    linear-gradient(145deg, var(--yh-color-panel-raised), var(--yh-color-panel)),
    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0 2rpx, transparent 2rpx 24rpx);
  border: 1rpx solid var(--yh-color-line);
}

.yh-btn--success {
  color: #06120b;
  background: linear-gradient(135deg, var(--yh-color-success), #1d7b45);
  box-shadow: 0 12rpx 28rpx rgba(69, 201, 120, 0.22);
}

.yh-btn--danger {
  color: #220704;
  background: linear-gradient(135deg, var(--yh-color-danger), #9d2918);
  box-shadow: 0 12rpx 28rpx rgba(239, 77, 50, 0.2);
}

.yh-btn--ghost {
  color: var(--yh-color-text-muted);
  background: transparent;
  border: 1rpx solid rgba(255, 214, 145, 0.16);
}

.yh-btn.is-disabled {
  color: var(--yh-color-text-faint);
  background: var(--yh-color-disabled);
  box-shadow: none;
  opacity: 0.62;
}

.yh-btn__icon {
  font-size: var(--yh-text-lg);
  line-height: 1;
}

.yh-btn__text {
  position: relative;
  z-index: 1;
}

.yh-btn__loader {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.36);
  border-top-color: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  animation: yh-btn-spin 760ms linear infinite;
}

@keyframes yh-btn-spin {
  to {
    transform: rotate(360deg);
  }
}
