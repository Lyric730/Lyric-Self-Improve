@import "../../styles/player-flow.wxss";

.invite-card {
  display: grid;
  gap: var(--yh-space-4);
  padding: 28rpx;
  background:
    radial-gradient(circle at 50% 18%, rgba(255, 118, 0, 0.18), transparent 260rpx),
    linear-gradient(180deg, rgba(37, 27, 18, 0.96), rgba(8, 7, 6, 0.98));
  border: 1rpx solid rgba(255, 136, 22, 0.34);
  box-shadow: var(--yh-shadow-panel);
  clip-path: polygon(22rpx 0, calc(100% - 22rpx) 0, 100% 22rpx, 100% calc(100% - 22rpx), calc(100% - 22rpx) 100%, 0 100%, 0 22rpx);
}

.invite-card__status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--yh-space-3);
}

.invite-card__status text:first-child {
  min-height: 44rpx;
  padding: 0 18rpx;
  color: #160b04;
  font-size: var(--yh-text-xs);
  font-weight: 900;
  line-height: 44rpx;
  background: linear-gradient(180deg, #ffcf72, #ff8b18);
  clip-path: polygon(12rpx 0, 100% 0, 100% calc(100% - 12rpx), calc(100% - 12rpx) 100%, 0 100%, 0 12rpx);
}

.invite-card__status text:last-child {
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
  font-weight: 900;
}

.accept-note {
  display: grid;
  gap: 10rpx;
  padding: 22rpx;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
  font-weight: 800;
  line-height: 1.5;
  background: rgba(8, 7, 6, 0.58);
  border: 1rpx solid rgba(255, 214, 145, 0.14);
  clip-path: polygon(14rpx 0, 100% 0, 100% calc(100% - 14rpx), calc(100% - 14rpx) 100%, 0 100%, 0 14rpx);
}
