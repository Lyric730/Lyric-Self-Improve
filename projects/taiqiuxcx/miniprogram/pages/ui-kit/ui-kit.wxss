@import "../../styles/tokens.wxss";

.ui-kit-page {
  min-height: 100vh;
  padding: var(--yh-page-pad);
  background:
    radial-gradient(circle at 88% 0, rgba(255, 118, 0, 0.14), transparent 210rpx),
    linear-gradient(145deg, var(--yh-color-bg), var(--yh-color-bg-2) 52%, #070604);
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: var(--yh-space-4);
  padding: var(--yh-space-5) 0 var(--yh-space-4);
}

.hero__eyebrow {
  display: block;
  color: var(--yh-color-orange);
  font-size: var(--yh-text-xs);
  font-weight: 900;
  letter-spacing: 0.18em;
}

.hero__title {
  display: block;
  margin-top: var(--yh-space-1);
  color: var(--yh-color-text);
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.04;
}

.hero__copy {
  display: block;
  margin-top: var(--yh-space-2);
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
}

.hero__table {
  flex: 0 0 188rpx;
  align-self: flex-start;
  padding: var(--yh-space-2);
  border: 1rpx solid var(--yh-color-line-strong);
  border-radius: var(--yh-radius-md);
  background: rgba(255, 118, 0, 0.1);
  text-align: right;
}

.hero__table-label,
.hero__table-time {
  display: block;
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-xs);
}

.hero__table-no {
  display: block;
  color: var(--yh-color-gold-bright);
  font-family: var(--yh-font-number);
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.section {
  display: grid;
  gap: var(--yh-space-3);
  margin-top: var(--yh-space-5);
}

.section__title {
  color: var(--yh-color-gold);
  font-size: var(--yh-text-lg);
  font-weight: 900;
}

.button-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--yh-space-2);
}

.button-grid yh-button:first-child {
  grid-column: 1 / -1;
}

.mode-stack {
  display: grid;
  gap: var(--yh-space-3);
}

.risk-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--yh-space-3);
}

.risk-line__label {
  color: var(--yh-color-text-muted);
  font-family: var(--yh-font-number);
  font-size: var(--yh-text-xl);
  font-weight: 900;
}

.risk-line__value {
  color: var(--yh-color-gold-bright);
  font-family: var(--yh-font-number);
  font-size: 64rpx;
  font-weight: 900;
}

.reward-card {
  display: grid;
  justify-items: center;
  padding: var(--yh-space-4);
  border: 1rpx solid rgba(255, 211, 107, 0.28);
  border-radius: var(--yh-radius-md);
  background:
    linear-gradient(145deg, rgba(217, 164, 65, 0.16), rgba(255, 118, 0, 0.08)),
    repeating-linear-gradient(90deg, transparent 0 28rpx, rgba(255, 211, 107, 0.05) 28rpx 30rpx);
}

.reward-card__range {
  color: var(--yh-color-gold-bright);
  font-family: var(--yh-font-number);
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
}

.reward-card__unit {
  margin-top: var(--yh-space-1);
  color: var(--yh-color-text);
  font-size: var(--yh-text-lg);
  font-weight: 900;
}

.reward-card__copy {
  margin-top: var(--yh-space-2);
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
}

.status-row {
  display: grid;
  gap: var(--yh-space-1);
  padding: var(--yh-space-3);
  border-radius: var(--yh-radius-sm);
  margin-bottom: var(--yh-space-2);
}

.status-row text:first-child {
  font-size: var(--yh-text-md);
  font-weight: 900;
}

.status-row text:last-child {
  color: var(--yh-color-text-muted);
  font-size: var(--yh-text-sm);
}

.status-row--success {
  border: 1rpx solid rgba(69, 201, 120, 0.36);
  background: rgba(69, 201, 120, 0.08);
}

.status-row--danger {
  border: 1rpx solid rgba(239, 77, 50, 0.42);
  background: rgba(239, 77, 50, 0.08);
}
