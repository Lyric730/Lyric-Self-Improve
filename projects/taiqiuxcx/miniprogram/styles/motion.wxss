.yh-pressable {
  transition: transform var(--yh-motion-fast) var(--yh-ease-out),
    opacity var(--yh-motion-fast) var(--yh-ease-out),
    box-shadow var(--yh-motion-fast) var(--yh-ease-out);
}

.yh-pressable:active {
  transform: scale(0.98);
}

.yh-number-pop {
  animation: yh-number-pop var(--yh-motion-base) var(--yh-ease-pop);
}

@keyframes yh-number-pop {
  0% {
    transform: scale(0.94);
    opacity: 0.72;
  }

  72% {
    transform: scale(1.08);
    opacity: 1;
  }

  100% {
    transform: scale(1);
  }
}
